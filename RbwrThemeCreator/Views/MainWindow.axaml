<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RbwrThemeCreator.ViewModels"
        xmlns:models="using:RbwrThemeCreator.Models"
        xmlns:services="using:RbwrThemeCreator.Services"
        xmlns:views="using:RbwrThemeCreator.Views"
        x:Class="RbwrThemeCreator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icon.ico"
        Width="1500" Height="940"
        MinWidth="1100" MinHeight="680"
        WindowDecorations="None"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">

    <Panel>
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource EdBorder}" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- =============== Header (styled like the overlay's HeaderBar) =============== -->
        <!-- Custom title bar: drag anywhere on the header, double-click to maximize. -->
        <Border Grid.Row="0" x:Name="TitleBar" Classes="hud-header" Background="{DynamicResource EdMain}"
                PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="/Assets/icon.png" Width="26" Height="26" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="RBWR THEME CREATOR" Classes="brand" />
                    <Button Classes="pill-btn" Command="{Binding CheckUpdatesCommand}"
                            ToolTip.Tip="Click to check for RBWR Theme Creator updates">
                        <TextBlock Text="{Binding AppVersionBadge}" Foreground="{DynamicResource EdGreen}" FontSize="9" FontWeight="Bold" />
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{DynamicResource EdBorder}" Margin="18,0" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ThemeName}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        <Border Classes="pill" BorderBrush="{DynamicResource EdGold}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}">
                            <TextBlock Text="UNSAVED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource EdGold}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="faint" Text="{Binding ThemeSubtitle}" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left" Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Classes="hud" Content="UNDO" Command="{Binding UndoCommand}" Padding="8,5" />
                    <Button x:Name="RedoButton" Classes="hud" Content="REDO" Command="{Binding RedoCommand}" Padding="8,5" Margin="0,0,4,0" />

                    <DropDownButton x:Name="NewButton" Classes="hud" Content="NEW">
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="2">
                                    <TextBlock Classes="section-title" Text="START FROM A PRESET" Margin="4,2,0,8" />
                                    <ItemsControl ItemsSource="{Binding Presets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:ThemePreset">
                                                <Button Classes="hud-list" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                                                        Click="OnPresetClick" Tag="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource EdCyan}" />
                                                        <TextBlock Classes="muted" Text="{Binding Description}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <DropDownButton Classes="hud" Content="OPEN" ToolTip.Tip="Open an existing theme">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem x:Name="MenuOpenFile" Header="Theme file (theme.json, .zip, .axaml)…" Command="{Binding OpenFileCommand}" />
                                <MenuItem x:Name="MenuOpenFolder" Header="Theme folder…" Command="{Binding OpenFolderCommand}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button x:Name="SaveButton" Classes="hud" Content="SAVE" Command="{Binding SaveCommand}" />

                    <DropDownButton Classes="hud" Content="EXPORT" ToolTip.Tip="Save a copy or export a shareable pack">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem x:Name="MenuSaveAs" Header="Save as new folder…" Command="{Binding SaveAsCommand}" />
                                <MenuItem x:Name="MenuExportZip" Header="Export .zip pack…" Command="{Binding ExportZipCommand}" />
                                <MenuItem Header="Copy theme.axaml" Command="{Binding CopyXamlCommand}" />
                                <Separator />
                                <MenuItem x:Name="MenuSavePreview" Header="Save preview image (PNG)…" Click="OnExportPreviewPngClick" />
                                <MenuItem x:Name="MenuCopyPreview" Header="Copy preview image (paste on Discord)" Click="OnCopyPreviewImageClick" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button x:Name="InstallButton" Classes="hud-green" Content="INSTALL TO OVERLAY" Command="{Binding InstallToOverlayCommand}" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Window controls styled like the overlay's header buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="1" Height="22" Background="{DynamicResource EdBorder}" Margin="0,0,10,0" />
                    <Button Classes="win-btn" Content="—" Click="OnMinimizeClick" ToolTip.Tip="Minimize" />
                    <Button Classes="win-btn" x:Name="MaximizeButton" Content="□" Click="OnMaximizeClick" ToolTip.Tip="Maximize" />
                    <Button Classes="win-btn win-close" Content="X" Click="OnCloseClick" ToolTip.Tip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- =============== Body =============== -->
        <Grid Grid.Row="1" ColumnDefinitions="740,1,*">

            <TabControl x:Name="NavTabs" Grid.Column="0" Classes="nav" TabStripPlacement="Left">

                <!-- Theme info -->
                <TabItem x:Name="ThemeTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE946;" /><TextBlock Text="THEME" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="18,16">
                            <TextBlock Classes="page-title" Text="THEME" />
                            <TextBlock Classes="page-sub" Text="Name and details shown in the overlay's theme list." />

                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="NAME" Margin="0,0,0,4" />
                                    <TextBox Classes="hud" Text="{Binding ThemeName}" PlaceholderText="My Theme" />

                                    <TextBlock Classes="label" Text="ID (FOLDER NAME — lowercase, no spaces)" />
                                    <TextBox Classes="hud" Text="{Binding ThemeId}" PlaceholderText="my-theme" />

                                    <Grid ColumnDefinitions="*,10,100,10,110">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Classes="label" Text="AUTHOR" />
                                            <TextBox Classes="hud" Text="{Binding Author}" PlaceholderText="Your name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Classes="label" Text="VERSION" />
                                            <TextBox Classes="hud" Text="{Binding Version}" PlaceholderText="1.0.0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Classes="label" Text="MIN. OVERLAY" />
                                            <TextBox Classes="hud commit" Text="{Binding MinAppVersion, UpdateSourceTrigger=LostFocus}" PlaceholderText="2.3.0"
                                                     ToolTip.Tip="Oldest overlay version this theme needs. Press Enter or Tab to apply." />
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="warn-box" Margin="0,8,0,0" IsVisible="{Binding HasAnimatedColours}">
                                        <TextBlock Classes="warn" TextWrapping="Wrap"
                                                   Text="This theme has animated colours, so Min. overlay can't be lower than 2.3.1 (older overlays can crash on them). Overlays older than that don't show this theme at all." />
                                    </Border>

                                    <TextBlock Classes="label" Text="DESCRIPTION" />
                                    <TextBox Classes="hud" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" PlaceholderText="Short description of the look" />

                                    <Border Classes="warn-box" Margin="0,12,0,0" IsVisible="{Binding HasManifestProblems}">
                                        <TextBlock Classes="warn" Text="{Binding ManifestProblems}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- How the theme's card looks in the overlay's Theme Manager, in the theme's own colours. -->
                            <Border Classes="card accent-card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="section-title" Text="IN THE OVERLAY'S THEME MANAGER" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="faint" Text="live preview" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Background="#0b0e14" CornerRadius="10" Padding="12">
                                        <!-- Card fill = the theme's main background (gradients included), like the overlay. -->
                                        <Border Background="{Binding CardWindowBrush}" BorderBrush="{Binding CardGlowBrush}"
                                                views:AnimationStrip.Animation="{Binding CardBackgroundAnimationPreview}"
                                                views:AnimationStrip.BorderAnimation="{Binding CardBorderAnimationPreview}"
                                                BorderThickness="1" CornerRadius="4" Padding="11,9">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Width="56" Height="54" Margin="0,0,10,0" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center"
                                                            BorderThickness="1.5" BorderBrush="Transparent"
                                                            views:AnimationStrip.BorderAnimation="{Binding ThumbAnimationPreview}"
                                                            ToolTip.Tip="The thumbnail (preview.png) is the MONITOR view of your theme">
                                                        <Image x:Name="ThemeCardThumb" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding CardName}" Foreground="{Binding CardTextBrush}" FontWeight="Bold" FontSize="12"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                                            <Border Background="{Binding CardPanelBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CardVersionText}" Foreground="{Binding CardGoldBrush}" FontSize="9" FontWeight="Bold" />
                                                            </Border>
                                                            <Border Background="{Binding CardPanelBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                                <TextBlock Text="CUSTOM" Foreground="{Binding CardMutedBrush}" FontSize="8.5" FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CardAuthorText}" Foreground="{Binding CardMutedBrush}" FontSize="10" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}"
                                                            BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="Apply" Foreground="{Binding CardAccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <TextBlock Classes="faint" TextWrapping="Wrap"
                                               Text="Shown with your theme's colours." />
                                    <Border Classes="divider" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="label" Text="THUMBNAIL" Margin="0" />
                                            <TextBlock Classes="muted" Text="{Binding ThumbnailModeText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="hud-red" Content="REMOVE" Command="{Binding UseAutoThumbnailCommand}" IsVisible="{Binding HasCustomThumbnail}"
                                                    ToolTip.Tip="Remove the custom image: the thumbnail is generated automatically again (the MONITOR view of your theme)" />
                                            <Button Classes="hud-blue" Content="CUSTOM IMAGE…" Command="{Binding ChooseCustomThumbnailCommand}"
                                                    ToolTip.Tip="Use your own picture (.png, .jpg, .webp, .bmp) as the thumbnail in the overlay's Theme Manager" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Classes="section-title" Text="SAVED LOCATION" />
                                        <TextBlock Classes="muted" Text="{Binding CurrentFolderDisplay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="hud" Content="Folder" Command="{Binding OpenCurrentFolderCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Recently opened / saved theme folders -->
                            <Border Classes="card" IsVisible="{Binding HasRecentThemes}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="section-title" Text="RECENT THEMES" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="guide-link" Content="CLEAR" FontSize="9.5" Command="{Binding ClearRecentThemesCommand}"
                                                ToolTip.Tip="Forget the recent list (the theme folders are not deleted)" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding RecentThemes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecentThemeEntry">
                                                <Button Classes="hud-list" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2"
                                                        Command="{ReflectionBinding $parent[Window].DataContext.OpenRecentCommand}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="{Binding Folder}">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Border Width="40" Height="39" Margin="0,0,10,0" CornerRadius="4" ClipToBounds="True"
                                                                Background="{DynamicResource EdPanel}" VerticalAlignment="Center">
                                                            <Panel>
                                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                <TextBlock Classes="icon" Text="&#xE790;" FontSize="14" Foreground="{DynamicResource EdFaint}"
                                                                           HorizontalAlignment="Center" IsVisible="{Binding !HasThumbnail}" />
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource EdCyan}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="faint" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Colours -->
                <TabItem x:Name="ColoursTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE790;" /><TextBlock Text="COLOURS" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="18,16">
                            <TextBlock Classes="page-title" Text="COLOURS" />
                            <TextBlock Classes="page-sub" Text="Click a swatch to pick a colour or type a hex value. Double-click a row to see where that colour is used in the preview." />

                            <Border Classes="card accent-card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="section-title" Text="GENERATE FROM ONE COLOUR" />
                                    <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                                        <views:HudColorPicker Grid.Column="0" Color="{Binding GeneratorAccent}" IsAlphaEnabled="False" />
                                        <ComboBox Grid.Column="2" Classes="hud" ItemsSource="{Binding MoodNames}" SelectedIndex="{Binding GeneratorMood}" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="4" Classes="hud-blue" Content="GENERATE" Command="{Binding GeneratePaletteCommand}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Content="Also change status colours (green / red / gold)" IsChecked="{Binding GeneratorStatusColours}" FontSize="11" />
                                        <Button Grid.Column="1" Classes="hud" Content="Reset to default" Command="{Binding ResetColoursToBaseCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="warn-box" Margin="0,0,0,10" Background="#120b24" BorderBrush="#66ff4fd8" IsVisible="{Binding ShowGradientTip}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontSize="10.5" TextWrapping="Wrap" Foreground="#ffb3f0"
                                               Text="TIP: click GRADIENT next to a colour (backgrounds, borders, accents) to turn it into a gradient. Try the 'Synthwave (gradients)' preset under NEW for an example." />
                                    <Button Grid.Column="1" Classes="guide-link" Content="×" FontSize="13" Padding="6,0" Margin="6,-4,-6,-4"
                                            VerticalAlignment="Top" Command="{Binding HideGradientTipCommand}" ToolTip.Tip="Hide this tip (show it again in SETTINGS)" />
                                </Grid>
                            </Border>
                            <Border Classes="ok-box" Margin="0,0,0,10" IsVisible="{Binding ShowContrastOk}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding ContrastSummary}" FontSize="10.5" Foreground="{DynamicResource EdGreen}" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Classes="guide-link" Content="×" FontSize="13" Padding="6,0" Margin="6,-4,-6,-4"
                                            VerticalAlignment="Top" Command="{Binding HideContrastCheckCommand}" ToolTip.Tip="Hide the contrast check (show it again in SETTINGS)" />
                                </Grid>
                            </Border>
                            <Border Classes="warn-box" Margin="0,0,0,10" IsVisible="{Binding ShowContrastWarning}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding ContrastSummary}" FontSize="10.5" Foreground="{DynamicResource EdGold}" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Classes="guide-link" Content="×" FontSize="13" Padding="6,0" Margin="6,-4,-6,-4"
                                            VerticalAlignment="Top" Command="{Binding HideContrastCheckCommand}" ToolTip.Tip="Hide the contrast check (show it again in SETTINGS)" />
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
                                <TextBox x:Name="TokenSearchBox" Classes="hud" Text="{Binding TokenSearch}" />
                                <Button Grid.Column="1" Classes="hud" Content="CLEAR" Margin="6,0,0,0" Command="{Binding ClearTokenSearchCommand}"
                                        IsVisible="{Binding TokenSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Button Grid.Column="2" Classes="hud" Content="COLLAPSE ALL" Margin="6,0,0,0" Command="{Binding CollapseAllColoursCommand}"
                                        ToolTip.Tip="Fold every group and every gradient / animation editor" />
                                <Button Grid.Column="3" Classes="hud" Content="EXPAND ALL" Margin="6,0,0,0" Command="{Binding ExpandAllColoursCommand}"
                                        ToolTip.Tip="Unfold every group" />
                            </Grid>
                            <TextBlock Classes="muted" Text="No colours match the search." Margin="4,0,0,10" IsVisible="{Binding HasNoSearchResults}" />

                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TokenGroupViewModel">
                                        <Border Classes="card" IsVisible="{Binding HasMatches}">
                                            <StackPanel>
                                                <Button Classes="group-head" Command="{Binding ToggleCommand}" ToolTip.Tip="Fold / unfold this group">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel>
                                                            <TextBlock Classes="section-title" Text="{Binding Name}" />
                                                            <TextBlock Classes="muted" Text="{Binding Description}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Classes="fold-glyph" Text="{Binding Glyph}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                                <ItemsControl ItemsSource="{Binding Tokens}" IsVisible="{Binding IsExpanded}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TokenViewModel">
                                                            <Border Classes="token-row" Classes.flash="{Binding IsFlashing}" IsVisible="{Binding IsMatch}" DoubleTapped="OnTokenRowDoubleTapped" Tag="{Binding Key}"
                                                                    ToolTip.Tip="Double-click to show where this colour is used" ToolTip.ShowDelay="900">
                                                                <StackPanel>
                                                                    <Grid ColumnDefinitions="Auto,*,Auto,90,148" RowDefinitions="Auto,Auto">
                                                                        <views:HudColorPicker Grid.Column="0" Color="{Binding Color}" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" Background="Transparent" ToolTip.Tip="{Binding Hint}" />
                                                                        <!-- Line 2: resource key, how the colour is drawn (one of three), a small live preview, fold arrow -->
                                                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,6,0,0">
                                                                            <TextBlock Classes="faint" Text="{Binding Key}" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="96" />
                                                                            <Border Grid.Column="1" Classes="seg-host" IsVisible="{Binding SupportsGradient}" VerticalAlignment="Center">
                                                                                <TabStrip Classes="seg mini" SelectedIndex="{Binding FillMode}">
                                                                                    <TabStripItem Content="SOLID" ToolTip.Tip="One plain colour" />
                                                                                    <TabStripItem Content="GRADIENT" ToolTip.Tip="Two to six colours blending into each other" />
                                                                                    <TabStripItem Content="ANIMATED" IsVisible="{Binding SupportsAnimation}"
                                                                                                  ToolTip.Tip="Colours that change by themselves in the overlay. Automatically raises Min. overlay to 2.3.1 if needed." />
                                                                                </TabStrip>
                                                                            </Border>
                                                                            <!-- Folded: the gradient / animation stays visible as a thin strip -->
                                                                            <Border Grid.Column="2" Classes="mini-strip" Background="{Binding PreviewBrush}" IsVisible="{Binding ShowGradientMini}" />
                                                                            <Border Grid.Column="2" Classes="mini-strip" views:AnimationStrip.Animation="{Binding AnimPreview}" IsVisible="{Binding ShowAnimMini}" />
                                                                            <Button Grid.Column="3" Classes="fold" Content="{Binding EditorGlyph}" Command="{Binding ToggleEditorCommand}"
                                                                                    IsVisible="{Binding HasEditor}" ToolTip.Tip="{Binding EditorToggleTip}" />
                                                                        </Grid>
                                                                        <TextBox Grid.Column="3" Classes="hud hex" Classes.invalid="{Binding HexInvalid}"
                                                                                 Text="{Binding HexText, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                                                                                 ToolTip.Tip="#rrggbb or #aarrggbb (press Tab to apply)" />
                                                                        <Grid Grid.Column="4" ColumnDefinitions="*,Auto" IsVisible="{Binding SupportsOpacity}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                              ToolTip.Tip="Opacity — lower values let the game show through">
                                                                            <Slider Minimum="0" Maximum="1" Value="{Binding Opacity}" />
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                                <TextBox Classes="num-input" Text="{Binding OpacityInput, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Type the opacity in % and press Enter" />
                                                                                <TextBlock Classes="num-suffix" Text="%" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Grid>

                                                                    <!-- Animation editor (only when ANIMATED is on): built like the gradient editor below -->
                                                                    <Border Classes="grad-panel" IsVisible="{Binding ShowAnimEditor}">
                                                                        <StackPanel Spacing="10">
                                                                            <Border Classes="grad-strip" views:AnimationStrip.Animation="{Binding AnimPreview}"
                                                                                    ToolTip.Tip="Live preview of the animation" />

                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                                                                                        <ItemsControl ItemsSource="{Binding AnimColours}">
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate x:DataType="vm:AnimationColourViewModel">
                                                                                                    <Border Classes="stop-chip">
                                                                                                        <StackPanel Spacing="4">
                                                                                                            <Grid ColumnDefinitions="*,Auto" Height="16">
                                                                                                                <TextBlock Classes="label" Text="{Binding Number}" Margin="2,0,0,0" VerticalAlignment="Center" />
                                                                                                                <Button Grid.Column="1" Classes="stop-remove" Content="×" Command="{Binding RemoveCommand}"
                                                                                                                        IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove this colour" />
                                                                                                            </Grid>
                                                                                                            <views:HudColorPicker Color="{Binding Color}" IsAlphaEnabled="False" HorizontalAlignment="Center" />
                                                                                                        </StackPanel>
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                        <Button Classes="stop-add" Command="{Binding AddAnimColourCommand}" IsEnabled="{Binding CanAddAnimColour}"
                                                                                                ToolTip.Tip="Add another colour to the animation (up to 4)" VerticalAlignment="Stretch">
                                                                                            <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                <TextBlock Text="+" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                                                                                <TextBlock Text="{Binding AnimStopCountText}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.75" />
                                                                                            </StackPanel>
                                                                                        </Button>
                                                                                    </StackPanel>
                                                                                </ScrollViewer>
                                                                                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                    <Button Classes="hud" Content="REVERSE" Command="{Binding ReverseAnimColoursCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Reverse the order of the colours" />
                                                                                    <Button Classes="hud" Content="SHIFT" Command="{Binding ShiftAnimColoursCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Move every colour one place (the last one becomes the first)" />
                                                                                    <Button Classes="hud" Content="RANDOM" Command="{Binding RandomAnimColoursCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="New colours that go well together" />
                                                                                </StackPanel>
                                                                            </Grid>

                                                                            <!-- How it moves + how fast -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                                <Border Classes="seg-host" VerticalAlignment="Center">
                                                                                    <TabStrip Classes="seg mini" SelectedIndex="{Binding AnimMode}">
                                                                                        <TabStripItem Content="ALL AT ONCE" ToolTip.Tip="Everything in this colour changes colour together" />
                                                                                        <TabStripItem Content="FLOW" ToolTip.Tip="The colours move along one after another, like a running gradient" />
                                                                                    </TabStrip>
                                                                                </Border>
                                                                                <Slider Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding AnimSeconds}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,0,6,0" VerticalAlignment="Center"
                                                                                        ToolTip.Tip="Seconds for one full loop: higher is calmer" />
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="Seconds for one loop (1 to 20). Type a number and press Enter.">
                                                                                    <TextBox Classes="num-input" Text="{Binding AnimSecondsInput, UpdateSourceTrigger=LostFocus}" />
                                                                                    <TextBlock Classes="num-suffix" Text="s" />
                                                                                </StackPanel>
                                                                            </Grid>

                                                                            <!-- Flow direction (same controls as the gradient direction) -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsFlow}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                                <Button Classes="dir" Content="→" Command="{Binding SetAnimDirectionCommand}" CommandParameter="0" ToolTip.Tip="Flow left to right" />
                                                                                <Button Classes="dir" Content="↘" Command="{Binding SetAnimDirectionCommand}" CommandParameter="45" ToolTip.Tip="Flow top-left to bottom-right" />
                                                                                <Button Classes="dir" Content="↓" Command="{Binding SetAnimDirectionCommand}" CommandParameter="90" ToolTip.Tip="Flow top to bottom" />
                                                                                <Button Classes="dir" Content="↙" Command="{Binding SetAnimDirectionCommand}" CommandParameter="135" ToolTip.Tip="Flow top-right to bottom-left" />
                                                                                <Button Classes="dir" Content="←" Command="{Binding SetAnimDirectionCommand}" CommandParameter="180" ToolTip.Tip="Flow right to left" />
                                                                                <Button Classes="dir" Content="↖" Command="{Binding SetAnimDirectionCommand}" CommandParameter="225" ToolTip.Tip="Flow bottom-right to top-left" />
                                                                                <Button Classes="dir" Content="↑" Command="{Binding SetAnimDirectionCommand}" CommandParameter="270" ToolTip.Tip="Flow bottom to top" />
                                                                                <Button Classes="dir" Content="↗" Command="{Binding SetAnimDirectionCommand}" CommandParameter="315" ToolTip.Tip="Flow bottom-left to top-right" />
                                                                                </StackPanel>
                                                                                <Slider Grid.Column="1" Minimum="0" Maximum="359" Value="{Binding AnimAngle}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,0,6,0" VerticalAlignment="Center"
                                                                                        ToolTip.Tip="Flow direction" />
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="Type the angle in degrees and press Enter">
                                                                                    <TextBox Classes="num-input" Text="{Binding AnimAngleInput, UpdateSourceTrigger=LostFocus}" />
                                                                                    <TextBlock Classes="num-suffix" Text="°" />
                                                                                </StackPanel>
                                                                            </Grid>

                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Gradient editor (only when GRAD is on) -->
                                                                    <Border Classes="grad-panel" IsVisible="{Binding ShowGradientEditor}">
                                                                        <StackPanel Spacing="10">
                                                                            <Border Classes="grad-strip" Background="{Binding PreviewBrush}" />

                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                                                                                        <ItemsControl ItemsSource="{Binding Stops}">
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate x:DataType="vm:GradientStopViewModel">
                                                                                                    <Border Classes="stop-chip">
                                                                                                        <StackPanel Spacing="4">
                                                                                                            <Grid ColumnDefinitions="*,Auto" Height="16">
                                                                                                                <TextBlock Classes="label" Text="{Binding Number}" Margin="2,0,0,0" VerticalAlignment="Center" />
                                                                                                                <Button Grid.Column="1" Classes="stop-remove" Content="×" Command="{Binding RemoveCommand}"
                                                                                                                        IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove this colour" />
                                                                                                            </Grid>
                                                                                                            <views:HudColorPicker Color="{Binding Color}" HorizontalAlignment="Center" />
                                                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip.Tip="Where this colour sits along the gradient: 0% = start, 100% = end. Type a number and press Enter.">
                                                                                                                <TextBox Classes="num-input" Text="{Binding PositionInput, UpdateSourceTrigger=LostFocus}" />
                                                                                                                <TextBlock Classes="num-suffix" Text="%" />
                                                                                                            </StackPanel>
                                                                                                        </StackPanel>
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                        <Button Classes="stop-add" Command="{Binding AddStopCommand}" IsEnabled="{Binding CanAddStop}"
                                                                                                ToolTip.Tip="Add another colour to the gradient (up to 6)" VerticalAlignment="Stretch">
                                                                                            <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                <TextBlock Text="+" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                                                                                <TextBlock Text="{Binding StopCountText}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.75" />
                                                                                            </StackPanel>
                                                                                        </Button>
                                                                                    </StackPanel>
                                                                                </ScrollViewer>
                                                                                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                    <Button Classes="hud" Content="REVERSE" Command="{Binding SwapCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Reverse the order of all colours (flips the gradient)" />
                                                                                    <Button Classes="hud" Content="SOFT" Command="{Binding SoftFadeCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Reset to a gentle two-colour fade from the first colour" />
                                                                                    <Button Classes="hud" Content="EVEN" Command="{Binding SpreadEvenlyCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Spread all colours evenly again (0% … 100%)" />
                                                                                </StackPanel>
                                                                            </Grid>

                                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                                <Button Classes="dir" Content="→" Command="{Binding SetDirectionCommand}" CommandParameter="0" ToolTip.Tip="Left to right" />
                                                                                <Button Classes="dir" Content="↘" Command="{Binding SetDirectionCommand}" CommandParameter="45" ToolTip.Tip="Top-left to bottom-right" />
                                                                                <Button Classes="dir" Content="↓" Command="{Binding SetDirectionCommand}" CommandParameter="90" ToolTip.Tip="Top to bottom" />
                                                                                <Button Classes="dir" Content="↙" Command="{Binding SetDirectionCommand}" CommandParameter="135" ToolTip.Tip="Top-right to bottom-left" />
                                                                                <Button Classes="dir" Content="←" Command="{Binding SetDirectionCommand}" CommandParameter="180" ToolTip.Tip="Right to left" />
                                                                                <Button Classes="dir" Content="↖" Command="{Binding SetDirectionCommand}" CommandParameter="225" ToolTip.Tip="Bottom-right to top-left" />
                                                                                <Button Classes="dir" Content="↑" Command="{Binding SetDirectionCommand}" CommandParameter="270" ToolTip.Tip="Bottom to top" />
                                                                                <Button Classes="dir" Content="↗" Command="{Binding SetDirectionCommand}" CommandParameter="315" ToolTip.Tip="Bottom-left to top-right" />
                                                                                </StackPanel>
                                                                                <Slider Grid.Column="1" Minimum="0" Maximum="359" Value="{Binding Angle}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,0,6,0" VerticalAlignment="Center"
                                                                                        ToolTip.Tip="Gradient direction" />
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="Type the angle in degrees and press Enter">
                                                                                    <TextBox Classes="num-input" Text="{Binding AngleInput, UpdateSourceTrigger=LostFocus}" />
                                                                                    <TextBlock Classes="num-suffix" Text="°" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Fonts -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE8D2;" /><TextBlock Text="FONTS" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="18,16">
                            <TextBlock Classes="page-title" Text="FONTS" />
                            <TextBlock Classes="page-sub" Text="Comma separated lists — the first font that exists wins. Add a .ttf / .otf file to ship a font with the theme." />

                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="MAIN FONT (AppFontFamily)" Margin="0,0,0,4" />
                                    <TextBox Classes="hud" Text="{Binding FontFamily}" />
                                    <TextBlock Classes="label" Text="NUMBERS / MONO FONT (AppMonoFontFamily)" />
                                    <TextBox Classes="hud" Text="{Binding MonoFontFamily}" />
                                    <Button Classes="hud" Content="Reset to default" Command="{Binding ResetFontsCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Classes="section-title" Text="FONT FILES" />
                                            <TextBlock Classes="muted" Text="Stored in fonts/ inside the theme." />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="hud-blue" Content="ADD FONT…" Command="{Binding AddFontCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Fonts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FontEntry">
                                                <Border Classes="token-row">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FamilyName}" FontWeight="Bold" />
                                                            <TextBlock Classes="faint" Text="{Binding FileName}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <Button Classes="hud" Content="Main" Command="{ReflectionBinding $parent[Window].DataContext.UseFontAsMainCommand}" CommandParameter="{Binding}" />
                                                            <Button Classes="hud" Content="Mono" Command="{ReflectionBinding $parent[Window].DataContext.UseFontAsMonoCommand}" CommandParameter="{Binding}" />
                                                            <Button Classes="hud-red" Content="X" Padding="8,4" ToolTip.Tip="Remove" Command="{ReflectionBinding $parent[Window].DataContext.RemoveFontCommand}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Shape -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE739;" /><TextBlock Text="SHAPE" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="18,16">
                            <TextBlock Classes="page-title" Text="SHAPE" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="page-sub" Text="Corner rounding, border thickness and an optional glow around the overlay window." />
                                <Button Grid.Column="1" Classes="hud" Content="Reset to default" Command="{Binding ResetShapeCommand}" VerticalAlignment="Top" Margin="12,0,0,0"
                                        ToolTip.Tip="Back to the overlay's default shapes (no rounding override, no glow)" />
                            </Grid>

                            <Border Classes="card">
                                <StackPanel>
                                    <ToggleSwitch IsChecked="{Binding ShapeEnabled}" OnContent="Custom shapes" OffContent="Overlay default shapes" />

                                    <Grid ColumnDefinitions="190,*,40" RowDefinitions="38,38,38,38,38" IsEnabled="{Binding ShapeEnabled}" Margin="0,8,0,0">
                                        <TextBlock Grid.Row="0" Classes="row-label" Text="WINDOW CORNERS" />
                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="24" Value="{Binding ShellCornerRadius}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="value" Text="{Binding ShellCornerRadius}" />

                                        <TextBlock Grid.Row="1" Classes="row-label" Text="WINDOW BORDER" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="4" Value="{Binding ShellBorderThickness}" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="value" Text="{Binding ShellBorderThickness}" />

                                        <TextBlock Grid.Row="2" Classes="row-label" Text="CARD CORNERS" />
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="16" Value="{Binding CardCornerRadius}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="value" Text="{Binding CardCornerRadius}" />

                                        <TextBlock Grid.Row="3" Classes="row-label" Text="BUTTON / INPUT CORNERS" />
                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="16" Value="{Binding ButtonCornerRadius}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Classes="value" Text="{Binding ButtonCornerRadius}" />

                                        <TextBlock Grid.Row="4" Classes="row-label" Text="COMPACT PILL CORNERS" />
                                        <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="24" Value="{Binding CompactCornerRadius}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Classes="value" Text="{Binding CompactCornerRadius}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" IsEnabled="{Binding ShapeEnabled}">
                                <StackPanel>
                                    <ToggleSwitch IsChecked="{Binding ShellGlow}" OnContent="Glow on" OffContent="Glow off" />
                                    <TextBlock Classes="muted" Text="Soft glow around the main window in the 'Shell border (glow)' colour." />
                                    <Grid ColumnDefinitions="190,*,40" Height="38" IsEnabled="{Binding ShellGlow}" Margin="0,6,0,0">
                                        <TextBlock Classes="row-label" Text="GLOW SIZE" />
                                        <Slider Grid.Column="1" Minimum="2" Maximum="40" Value="{Binding ShellGlowBlur}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding ShellGlowBlur}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Images -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xEB9F;" /><TextBlock Text="IMAGES" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="18,16">
                            <TextBlock Classes="page-title" Text="IMAGES" />
                            <TextBlock Classes="page-sub" Text="A background picture for the overlay window, plus any images your custom styles use." />

                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Classes="section-title" Text="BACKGROUND IMAGE" />
                                            <TextBlock Classes="muted" Text="Replaces the main background colour of the overlay window." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="hud-blue" Content="CHOOSE…" Command="{Binding ChooseBackgroundImageCommand}" />
                                            <Button Classes="hud-red" Content="REMOVE" Command="{Binding ClearBackgroundImageCommand}" IsVisible="{Binding HasBackgroundImage}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="110,*,44" RowDefinitions="38,38,38" IsVisible="{Binding HasBackgroundImage}">
                                        <TextBlock Classes="row-label" Text="IMAGE" />
                                        <ComboBox Grid.Column="1" Grid.ColumnSpan="2" Classes="hud" ItemsSource="{Binding AssetNames}" SelectedItem="{Binding BackgroundImageFile}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Classes="row-label" Text="OPACITY" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.05" Maximum="1" Value="{Binding BackgroundImageOpacity}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="value" Text="{Binding BackgroundImageOpacity, StringFormat={}{0:P0}}" />
                                        <TextBlock Grid.Row="2" Classes="row-label" Text="FIT" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="hud" ItemsSource="{Binding StretchModes}" SelectedItem="{Binding BackgroundStretch}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Classes="section-title" Text="IMAGE FILES" />
                                            <TextBlock Classes="muted" Text="Stored in assets/. Use in custom styles as Source=&quot;assets/name.png&quot;." />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="hud-blue" Content="ADD…" Command="{Binding AddImageCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Assets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ThemeFile">
                                                <Border Classes="token-row">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding FileName, StringFormat=assets/{0}}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Classes="hud-red" Content="X" Padding="8,4" ToolTip.Tip="Remove" Command="{ReflectionBinding $parent[Window].DataContext.RemoveAssetCommand}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Advanced -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE943;" /><TextBlock Text="ADVANCED" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="18,16">
                            <TextBlock Classes="page-title" Text="ADVANCED" />
                            <TextBlock Classes="page-sub" Text="Your own Avalonia styles and resources. They override colours and fonts; SHAPE (when on) is applied last. Errors appear above the preview." />

                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="section-title" Text="CUSTOM STYLES" VerticalAlignment="Center" />
                                        <DropDownButton Grid.Column="1" Classes="hud" Content="INSERT EXAMPLE">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Bigger title" Command="{Binding InsertStyleSnippetCommand}" CommandParameter="title" />
                                                    <MenuItem Header="Thicker active tab line" Command="{Binding InsertStyleSnippetCommand}" CommandParameter="nav" />
                                                    <MenuItem Header="Bigger power readout" Command="{Binding InsertStyleSnippetCommand}" CommandParameter="readout" />
                                                    <MenuItem Header="Image behind power banner" Command="{Binding InsertStyleSnippetCommand}" CommandParameter="image" />
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </Grid>
                                    <TextBox Classes="hud code" Text="{Binding CustomStyles}" MinHeight="280" MaxHeight="560"
                                             PlaceholderText="&lt;Style Selector=&quot;Border.hud-card&quot;&gt; … &lt;/Style&gt;" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="section-title" Text="EXTRA RESOURCES" />
                                    <TextBlock Classes="muted" Text="Placed inside &lt;Styles.Resources&gt; — e.g. gradient brushes referenced from your styles." />
                                    <TextBox Classes="hud code" Text="{Binding CustomResources}" MinHeight="110" MaxHeight="320"
                                             PlaceholderText="&lt;LinearGradientBrush x:Key=&quot;MyGradient&quot; … /&gt;" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="section-title" Text="SELECTOR REFERENCE" />
                                    <TextBlock Classes="muted" Text="Classes: overlay-shell, popup-shell, compact-shell, overlay-title, status-pill, sync-pill, hud-card, sub-panel, hud-header, nav-bar, power-banner, power-readout, power-subtext, preset-card, metric-card, hud-footer, config-card, sync-card, feedback-card" />
                                    <TextBlock Classes="muted" Text="Buttons: cyber, cyber-nav, cyber-blue, cyber-green, cyber-gold, cyber-red, cyber-header-btn, cyber-close(-btn), cyber-preset, cyber-tick — states :pointerover, :pressed, .active, .error. Inputs: TextBox.cyber, ComboBox.cyber, ProgressBar.cyber-power, Slider, ToolTip." />
                                    <TextBlock Classes="muted" Text="Named: #DetailedShell, #HeaderBar, #OverlayTitle, #SyncBadge, #NavBar, #PowerBanner, #MainPowerReadout, #MainPowerBar, #MainPowerSubtext, #DemandPresetCard, #DemandPresetSlider, #MonitorMetricsGrid, #DemandInputCard, #CorePowerCard, #GenLoadCard, #FlowCard, #StatusFooterBar, #ThemeConfigCard, #UiScaleSlider, #CompactShell, #CompactDemandInput, #CompactCounterButton …" />
                                    <TextBlock Classes="muted" Text="Not allowed by the overlay: x:Class, StyleInclude / ResourceInclude, clr-namespace or non-Avalonia using: namespaces." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Generated XAML -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE8A5;" /><TextBlock Text="CODE" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <DockPanel Margin="18,16">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Classes="page-title" Text="THEME.AXAML" />
                                <TextBlock Classes="muted" Text="Read-only — exactly what gets saved." />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="hud-blue" Content="COPY" Command="{Binding CopyXamlCommand}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBox Classes="hud code" Text="{Binding GeneratedXaml, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>
                </TabItem>

                <!-- Overlay -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE7F4;" /><TextBlock Text="OVERLAY" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="18,16">
                            <TextBlock Classes="page-title" Text="OVERLAY" />
                            <TextBlock Classes="page-sub" Text="Install the theme straight into the overlay, or open one that is already installed." />

                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="section-title" Text="THEMES FOLDER" />
                                    <TextBlock Classes="muted" Text="The overlay loads themes from the 'themes' folder next to RbwrOverlay.exe." />
                                    <TextBox Classes="hud" Text="{Binding OverlayThemesDirectory}" PlaceholderText="Not found — use Find overlay…" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="hud" Content="Detect" Command="{Binding DetectOverlayCommand}" ToolTip.Tip="Finds a running overlay or one next to this app" />
                                        <Button Classes="hud" Content="Find overlay…" Command="{Binding BrowseOverlayCommand}" />
                                        <Button Classes="hud" Content="Folder" Command="{Binding OpenOverlayThemesFolderCommand}" />
                                    </StackPanel>
                                    <Border Classes="divider" />
                                    <Button Classes="hud-green" Content="INSTALL / UPDATE THIS THEME" Command="{Binding InstallToOverlayCommand}" HorizontalAlignment="Stretch" Padding="0,8" />
                                    <TextBlock Classes="muted" Text="Then in the overlay: CONFIG → Reload → choose the theme. Click Reload again after every update." />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="section-title" Text="INSTALLED THEMES" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="hud" Content="Refresh" Command="{Binding RefreshInstalledThemesCommand}" />
                                    </Grid>
                                    <ListBox Classes="hud" ItemsSource="{Binding InstalledThemes}" SelectedItem="{Binding SelectedInstalledTheme}" MinHeight="120" MaxHeight="300" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="hud-blue" Content="OPEN SELECTED" Command="{Binding OpenInstalledCommand}" />
                                        <Button Classes="hud-red" Content="DELETE SELECTED" Command="{Binding DeleteInstalledCommand}"
                                                ToolTip.Tip="Permanently delete the selected theme folder from the overlay" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Settings -->
                <TabItem x:Name="SettingsTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE713;" /><TextBlock Text="SETTINGS" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="18,16">
                            <TextBlock Classes="page-title" Text="SETTINGS" />
                            <TextBlock Classes="page-sub" Text="Saved for you on this PC. Nothing here changes your themes." />

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="section-title" Text="START-UP" />
                                    <StackPanel Spacing="2">
                                        <CheckBox Content="Open the last theme at start" IsChecked="{Binding OpenLastThemeAtStart}" FontSize="12" />
                                        <TextBlock Classes="muted" Margin="28,0,0,0" Text="Opens the newest theme from Recent themes instead of a new Cyberpunk theme." />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <CheckBox Content="Autosave unsaved work (every 30 seconds)" IsChecked="{Binding AutosaveEnabled}" FontSize="12" />
                                        <TextBlock Classes="muted" Margin="28,0,0,0" Text="Keeps a copy of your unsaved changes. If the creator crashes or is closed by force, it offers to restore them at the next start." />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <CheckBox Content="Create missing thumbnails automatically" IsChecked="{Binding AutoCreateThumbnails}" FontSize="12" />
                                        <TextBlock Classes="muted" Margin="28,0,0,0" Text="Adds a preview.png to opened themes, and at start-up to installed overlay themes that have none. Save, Export and Install always write one." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="section-title" Text="DEFAULT AUTHOR" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBox Classes="hud" Text="{Binding DefaultAuthorInput}" PlaceholderText="Your name"
                                                 ToolTip.Tip="Type your name, then click SET or press Enter">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding SetDefaultAuthorCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Classes="hud-blue" Content="SET" Margin="6,0,0,0" MinWidth="64"
                                                HorizontalContentAlignment="Center" Command="{Binding SetDefaultAuthorCommand}"
                                                ToolTip.Tip="Save this as the author for new themes (empty = use the last author you saved with)" />
                                    </Grid>
                                    <TextBlock Classes="muted" Text="{Binding DefaultAuthorHint}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="section-title" Text="COLOURS TAB" />
                                    <StackPanel Spacing="2">
                                        <CheckBox Content="Show the gradient tip" IsChecked="{Binding ShowGradientTip}" FontSize="12" />
                                        <TextBlock Classes="muted" Margin="28,0,0,0" Text="The pink box about GRADIENT at the top of the COLOURS tab." />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <CheckBox Content="Show the contrast check" IsChecked="{Binding ShowContrastCheck}" FontSize="12" />
                                        <TextBlock Classes="muted" Margin="28,0,0,0" Text="The box that says whether text is readable on your backgrounds. When it is hidden you also miss its low-contrast warning." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="section-title" Text="UPDATES" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="muted" Text="{Binding UpdateStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Classes="hud-blue" Content="CHECK UPDATES" Command="{Binding CheckUpdatesCommand}"
                                                IsEnabled="{Binding !IsCheckingUpdates}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <CheckBox Content="Check for updates at start" IsChecked="{Binding CheckUpdatesAtStart}" FontSize="12" />
                                        <TextBlock Classes="muted" Margin="28,0,0,0" Text="You can also check any time with the green version badge in the title bar." />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="muted" Text="{Binding SkippedVersionText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="hud" Content="OFFER IT AGAIN" Command="{Binding UnskipVersionCommand}"
                                                IsVisible="{Binding HasSkippedVersion}" ToolTip.Tip="Forget the skipped update so it is offered again" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="section-title" Text="KEYBOARD SHORTCUTS" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="hud-red" Content="RESET SHORTCUTS" Command="{Binding ResetShortcutsCommand}"
                                                ToolTip.Tip="Set every shortcut back to its default (other settings are kept)" />
                                    </Grid>
                                    <TextBlock Classes="muted"
                                               Text="Click a shortcut, then press the new keys. Hold Ctrl, Alt or Win, or use an F-key. Esc cancels, Backspace removes the shortcut. If another action used those keys, it loses them. Esc and Ctrl+click in the preview are fixed." />
                                    <ItemsControl ItemsSource="{Binding ShortcutEntries}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ShortcutEntryViewModel">
                                                <Border Classes="token-row">
                                                    <Grid ColumnDefinitions="70,*,160,34">
                                                        <TextBlock Classes="faint" Text="{Binding Group}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                                            <TextBlock Classes="faint" Text="{Binding DefaultText, StringFormat='default: {0}'}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="hud shortcut" Classes.recording="{Binding IsRecording}" Classes.custom="{Binding IsCustom}"
                                                                Content="{Binding ButtonText}" Command="{Binding RecordCommand}"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                ToolTip.Tip="Click, then press the new keys" />
                                                        <Button Grid.Column="3" Classes="guide-link" Content="↺" FontSize="13" Margin="4,0,0,0"
                                                                Command="{Binding ResetToDefaultCommand}" IsVisible="{Binding IsCustom}"
                                                                ToolTip.Tip="Back to the default shortcut" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="section-title" Text="RESET" />
                                    <TextBlock Classes="muted"
                                               Text="Resets the start-up and update options, the default author, the COLOURS tab boxes, the skipped update, the recent themes list and the preview view. Keyboard shortcuts (they have their own reset above), the overlay folder and your themes are kept." />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="hud-red" Content="RESET SETTINGS" Command="{Binding ResetSettingsCommand}" />
                                        <Button Classes="hud" Content="OPEN SETTINGS FOLDER" Command="{Binding OpenSettingsFolderCommand}"
                                                ToolTip.Tip="The folder with settings.json" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- User guide (GUIDE.md rendered in the editor's style) -->
                <TabItem x:Name="GuideTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE897;" /><TextBlock Text="GUIDE" VerticalAlignment="Center" /></StackPanel>
                    </TabItem.Header>
                    <views:GuideView x:Name="GuidePage" />
                </TabItem>
            </TabControl>

            <Border Grid.Column="1" Background="{DynamicResource EdBorder}" />

            <!-- =============== Live preview =============== -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Classes="hud-header" Padding="14,8">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center">
                        <TextBlock Text="LIVE PREVIEW" Classes="section-title" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Border Classes="seg-host">
                            <TabStrip Classes="seg" SelectedIndex="{Binding PreviewMode}">
                                <TabStripItem Content="MONITOR" />
                                <TabStripItem Content="CONFIG" />
                                <TabStripItem Content="COMPACT" />
                                <TabStripItem Content="TABLET" />
                                <TabStripItem Content="ALL" />
                            </TabStrip>
                        </Border>
                        <ComboBox Classes="hud" ItemsSource="{Binding BackdropNames}" SelectedIndex="{Binding PreviewBackdrop}" Width="136" VerticalAlignment="Center" ToolTip.Tip="What is behind the overlay" />
                        <ToggleButton Classes="hud" IsChecked="{Binding PreviewFit}" Content="FIT" VerticalAlignment="Center" ToolTip.Tip="Scale the preview to fit the panel" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsEnabled="{Binding !PreviewFit}">
                            <Slider Minimum="0.25" Maximum="4" Value="{Binding PreviewZoom}" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="90" VerticalAlignment="Center" />
                            <TextBlock x:Name="ZoomText" Width="36" VerticalAlignment="Center" Foreground="{DynamicResource EdCyan}" FontWeight="Bold" FontSize="11" />
                        </StackPanel>
                        <ToggleButton x:Name="InspectToggle" Classes="hud" Content="FIND COLOUR" VerticalAlignment="Center"
                                      IsCheckedChanged="OnInspectToggled" />
                        <Button x:Name="PngButton" Classes="hud" Content="PNG" Click="OnExportPreviewPngClick" Padding="9,5" VerticalAlignment="Center" />
                        <Button x:Name="CopyButton" Classes="hud" Content="COPY" Click="OnCopyPreviewImageClick" Padding="9,5" VerticalAlignment="Center" />
                    </WrapPanel>
                </Border>

                <Border DockPanel.Dock="Top" Background="#2a0a12" BorderBrush="{DynamicResource EdRed}" BorderThickness="0,0,0,1" Padding="14,8" IsVisible="{Binding HasPreviewError}">
                    <SelectableTextBlock Text="{Binding PreviewError}" Foreground="#ff8099" TextWrapping="Wrap" FontSize="11.5" />
                </Border>

                <Border x:Name="Backdrop" ClipToBounds="True">
                    <Panel>
                        <!-- Free zoom/pan canvas: wheel zooms at the cursor, drag moves, double-click fits. -->
                        <Canvas x:Name="Viewport" Background="Transparent" ClipToBounds="True">
                            <LayoutTransformControl x:Name="ZoomHost">
                                <Border x:Name="PreviewHost">
                                    <views:OverlayPreview x:Name="Preview" />
                                </Border>
                            </LayoutTransformControl>
                        </Canvas>
                        <Border Classes="canvas-hint" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" IsHitTestVisible="False">
                            <TextBlock Text="SCROLL: ZOOM  ·  DRAG: MOVE  ·  DOUBLE-CLICK: FIT  ·  CTRL+CLICK: FIND COLOUR" />
                        </Border>
                    </Panel>
                </Border>
            </DockPanel>
        </Grid>

        <!-- =============== Status bar (like the overlay's footer) =============== -->
        <Border Grid.Row="2" Classes="hud-footer-bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="STATUS:" Foreground="{DynamicResource EdMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes.error="{Binding StatusIsError}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource EdCyan}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="faint" Text="{Binding CurrentFolderDisplay}" TextTrimming="CharacterEllipsis" MaxWidth="520" Margin="16,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
    </Border>

    <!-- Off-screen area where theme thumbnails (preview.png) are rendered: zero size and clipped. -->
    <Canvas x:Name="ThumbRenderHost" Width="0" Height="0" ClipToBounds="True" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Top" />

    <!-- Toast (bottom-right), e.g. "THUMBNAIL CREATED" -->
    <Border x:Name="Toast" Classes="toast" IsVisible="False" Opacity="0" IsHitTestVisible="False"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,46">
        <Grid ColumnDefinitions="Auto,*">
            <Border x:Name="ToastBar" Width="3" CornerRadius="2" Background="{DynamicResource EdGreen}" Margin="0,0,10,0" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="ToastTitle" Text="THUMBNAIL CREATED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource EdGreen}" />
                <TextBlock x:Name="ToastText" FontSize="11" Foreground="{DynamicResource EdText}" TextWrapping="Wrap" MaxWidth="320" />
            </StackPanel>
        </Grid>
    </Border>

    <!-- Resize grips (the window has no native frame at all) -->
    <Panel x:Name="ResizeGrips">
        <Border Classes="grip" Tag="North" Height="5" VerticalAlignment="Top" Margin="10,0" Cursor="TopSide" PointerPressed="OnResizeGripPressed" />
        <Border Classes="grip" Tag="South" Height="5" VerticalAlignment="Bottom" Margin="10,0" Cursor="BottomSide" PointerPressed="OnResizeGripPressed" />
        <Border Classes="grip" Tag="West" Width="5" HorizontalAlignment="Left" Margin="0,10" Cursor="LeftSide" PointerPressed="OnResizeGripPressed" />
        <Border Classes="grip" Tag="East" Width="5" HorizontalAlignment="Right" Margin="0,10" Cursor="RightSide" PointerPressed="OnResizeGripPressed" />
        <Border Classes="grip" Tag="NorthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="TopLeftCorner" PointerPressed="OnResizeGripPressed" />
        <Border Classes="grip" Tag="NorthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="TopRightCorner" PointerPressed="OnResizeGripPressed" />
        <Border Classes="grip" Tag="SouthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="BottomLeftCorner" PointerPressed="OnResizeGripPressed" />
        <Border Classes="grip" Tag="SouthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="BottomRightCorner" PointerPressed="OnResizeGripPressed" />
    </Panel>
    </Panel>
</Window>
