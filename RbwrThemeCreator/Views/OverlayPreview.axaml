<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RbwrThemeCreator.Views"
             x:Class="RbwrThemeCreator.Views.OverlayPreview">

    <!--
      Static mock of the overlay windows. Element names and classes match
      RbwrOverlay.UI/Views/DetailedOverlayView.axaml and CompactOverlayView.axaml,
      so selectors written for the overlay (e.g. Border#PowerBanner) also apply here.
    -->
    <Panel>
    <Grid x:Name="PreviewRoot" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" Margin="28">

            <!-- ================= Detailed overlay: MONITOR tab ================= -->
            <Border x:Name="DetailedShell" Classes="overlay-shell" Width="470" Height="455" VerticalAlignment="Top">
                <Grid x:Name="DetailedRootGrid" RowDefinitions="Auto,Auto,*">
                    <Grid x:Name="HeaderBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="OverlayTitle" Classes="overlay-title" Text="RBWR OVERLAY"
                                       Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="12" LetterSpacing="1"
                                       VerticalAlignment="Center" ToolTip.Tip="Drag to move the overlay" />
                            <Border x:Name="SyncBadge" Classes="status-pill sync-pill" BorderBrush="{DynamicResource NeonGreen}" Padding="6,2">
                                <TextBlock Text="SYNCED" Foreground="{DynamicResource NeonGreen}" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="cyber-header-btn" Content="UNPIN" />
                            <Button Classes="cyber-header-btn" Content="—" />
                            <Button x:Name="CloseButton" Classes="cyber-close-btn" Content="X" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="NavBar" Classes="hud-card nav-bar" Grid.Row="1" Margin="0,0,0,10" ClipToBounds="True">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Button x:Name="NavMonitorTab" Grid.Column="0" Classes="cyber-nav active" Content="MONITOR"
                                    CornerRadius="{Binding #NavBar.CornerRadius, Converter={x:Static views:CornerRadiusEdgeConverter.LeftOnly}}"
                                    HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Classes="cyber-nav" Content="SERVER SYNC" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Classes="cyber-nav" Content="CONFIG" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="3" Classes="cyber-nav" Content="FEEDBACK"
                                    CornerRadius="{Binding #NavBar.CornerRadius, Converter={x:Static views:CornerRadiusEdgeConverter.RightOnly}}"
                                    HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <Grid x:Name="UnitButtons" Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,0,0,8">
                            <Button x:Name="Unit1Button" Grid.Column="0" Classes="cyber active" Content="UNIT 01 (APRM)" Margin="0,0,3,0" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Classes="cyber" Content="UNIT 02 (RTP)" Margin="3,0,3,0" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Classes="cyber" Content="TCR (MSS/OCL)" Margin="3,0,0,0" HorizontalAlignment="Stretch" />
                        </Grid>

                        <Border x:Name="PowerBanner" Classes="hud-card power-banner" Grid.Row="1"
                                BorderBrush="{DynamicResource NeonGreen}" Padding="12,8" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="MainPowerReadout" Classes="power-readout" Text="98.40% APRM"
                                           Foreground="{DynamicResource NeonGreen}" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" />
                                <ProgressBar x:Name="MainPowerBar" Classes="cyber-power" Value="82" Minimum="0" Maximum="120"
                                             Foreground="{DynamicResource NeonGreen}" Margin="10,2" />
                                <TextBlock x:Name="MainPowerSubtext" Classes="power-subtext" Text="APRM REACTOR POWER STATUS"
                                           Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DemandPresetCard" Classes="hud-card preset-card" Grid.Row="2" Padding="8,6" Margin="0,0,0,8">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="DEMAND PRESET" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="950 MW" Foreground="{DynamicResource NeonCyan}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="DemandPresetSlider" Minimum="0" Maximum="1200" Value="950" Margin="0,-2" />
                                <Grid ColumnDefinitions="300*,300*,350*,150*,100*" Margin="6,0,6,0">
                                    <Button Grid.Column="0" Classes="cyber-tick" Content="0" HorizontalAlignment="Left" />
                                    <Button Grid.Column="0" Classes="cyber-tick" Content="300" HorizontalAlignment="Right" Margin="0,0,-12,0" />
                                    <Button Grid.Column="1" Classes="cyber-tick" Content="600" HorizontalAlignment="Right" Margin="0,0,-12,0" />
                                    <Button Grid.Column="2" Classes="cyber-tick active" Content="950" HorizontalAlignment="Right" Margin="0,0,-12,0" />
                                    <Button Grid.Column="3" Classes="cyber-tick" Content="1100" HorizontalAlignment="Right" Margin="0,0,-14,0" />
                                    <Button Grid.Column="4" Classes="cyber-tick" Content="1200" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="MonitorMetricsGrid" Grid.Row="3" ColumnDefinitions="*,*" RowDefinitions="*,*" Margin="0,0,0,8">
                            <Border x:Name="DemandInputCard" Classes="hud-card metric-card" Grid.Row="0" Grid.Column="0" Padding="8,6" Margin="0,0,4,4">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="DEMAND LOAD (MWe)" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                                        <Button Grid.Column="0" Classes="cyber" Content="-50" FontSize="9" Padding="4,2" Margin="0,0,2,0" />
                                        <Button Grid.Column="1" Classes="cyber" Content="-10" FontSize="9" Padding="4,2" Margin="0,0,2,0" />
                                        <TextBox x:Name="DemandTextBox" Grid.Column="2" Classes="cyber" Text="950" FontSize="12" Padding="2,0" />
                                        <Button Grid.Column="3" Classes="cyber" Content="+10" FontSize="9" Padding="4,2" Margin="2,0,0,0" />
                                        <Button Grid.Column="4" Classes="cyber" Content="+50" FontSize="9" Padding="4,2" Margin="2,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CorePowerCard" Classes="hud-card metric-card" Grid.Row="0" Grid.Column="1" Padding="8,6" Margin="4,0,0,4">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="CORE POWER (APRM%)" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                        <TextBox Classes="cyber" Text="98.4" Width="74" FontSize="12" Padding="2,0" />
                                        <TextBlock Text="%" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="GenLoadCard" Classes="hud-card metric-card" Grid.Row="1" Grid.Column="0" Padding="8,6" Margin="0,4,4,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="GENERATOR LOAD" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock x:Name="GenLoadValue" Text="948.37 MWe" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="13" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="FlowCard" Classes="hud-card metric-card" Grid.Row="1" Grid.Column="1" Padding="8,6" Margin="4,4,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="FEEDWATER FLOW" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock x:Name="FlowValue" Text="1842.56 kg/s" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="StatusFooterBar" Classes="hud-footer" Grid.Row="4" Padding="8,5">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="UPCOMING DEMAND:" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DtlText" Text="02:41" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="cyber" Content="Open Tablet" HorizontalAlignment="Center" Padding="8,1" FontSize="9" />
                                <TextBlock Grid.Column="2" Text="Aux Usage: 26.44 MWe" Foreground="{DynamicResource TextMuted}" FontSize="9" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= Detailed overlay: CONFIG / SYNC controls ================= -->
            <Border x:Name="ConfigShell" Classes="overlay-shell" Width="470" VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <Border x:Name="ConfigNavBar" Classes="hud-card nav-bar" ClipToBounds="True">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Button Grid.Column="0" Classes="cyber-nav" Content="MONITOR"
                                    CornerRadius="{Binding #ConfigNavBar.CornerRadius, Converter={x:Static views:CornerRadiusEdgeConverter.LeftOnly}}"
                                    HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Classes="cyber-nav" Content="SERVER SYNC" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Classes="cyber-nav active" Content="CONFIG" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="3" Classes="cyber-nav" Content="FEEDBACK"
                                    CornerRadius="{Binding #ConfigNavBar.CornerRadius, Converter={x:Static views:CornerRadiusEdgeConverter.RightOnly}}"
                                    HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Border x:Name="ThemeConfigCard" Classes="hud-card config-card" Padding="10,8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="OVERLAY THEME" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="10" />
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox x:Name="ThemeCombo" Grid.Column="0" Classes="cyber" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,4,0">
                                    <ComboBoxItem Content="Your theme" />
                                    <ComboBoxItem Content="Cyberpunk (Built-in)" />
                                    <ComboBoxItem Content="Reactor Amber (Built-in)" />
                                </ComboBox>
                                <Button Grid.Column="1" Classes="cyber-blue" Content="Apply" Padding="10,4" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button Grid.Column="0" Classes="cyber" Content="Install" Margin="0,0,2,0" FontSize="10" Padding="4,3" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Classes="cyber" Content="Reload" Margin="2,0" FontSize="10" Padding="4,3" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" Classes="cyber" Content="Template" Margin="2,0" FontSize="10" Padding="4,3" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="3" Classes="cyber" Content="Folder" Margin="2,0,0,0" FontSize="10" Padding="4,3" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="hud-card config-card" Padding="10,4">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="UI Scale (Full HUD):" VerticalAlignment="Center" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="125%" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="11" />
                            </Grid>
                            <Slider x:Name="UiScaleSlider" Minimum="0.75" Maximum="2" Value="1.25" Margin="0,-2" />
                            <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,4">
                                <Button Grid.Column="0" Classes="cyber-preset" Content="75%" Margin="0,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Column="1" Classes="cyber-preset" Content="100%" Margin="1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Column="2" Classes="cyber-preset active" Content="125%" Margin="1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Column="3" Classes="cyber-preset" Content="150%" Margin="1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Column="4" Classes="cyber-preset" Content="200%" Margin="2,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="hud-card config-card" Padding="10,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Hover tooltips" VerticalAlignment="Center" FontSize="11" />
                            <Button Grid.Column="1" Classes="cyber" Content="ON" Foreground="{DynamicResource NeonGreen}" Padding="10,3" />
                        </Grid>
                    </Border>

                    <Border x:Name="SyncCard" Classes="hud-card sync-card" Padding="10,8">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="SERVER CONNECTION" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="cyber-green" Content="CONNECT" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="DEMAND TIME LEFT (DTL)" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="10" />
                                <TextBlock Grid.Column="1" Text="02:41" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="10" />
                            </Grid>
                            <ProgressBar Classes="cyber-power" Value="64" Foreground="{DynamicResource NeonGold}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <Button Classes="cyber-gold" Content="CALIBRATE" />
                                <Button x:Name="ResetButton" Classes="cyber-red" Content="RESET" />
                                <Button Classes="cyber error" Content="SYNC ERROR" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SubPanel" Classes="hud-card sub-panel" Padding="10,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="SUB PANEL / MUTED TEXT" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                            <WrapPanel>
                                <TextBlock x:Name="MainTextSample" Text="Main text  " FontSize="11" />
                                <TextBlock Text="Accent  " Foreground="{DynamicResource NeonCyan}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="OK  " Foreground="{DynamicResource NeonGreen}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Warning  " Foreground="{DynamicResource NeonGold}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Alarm  " Foreground="{DynamicResource NeonRed}" FontSize="11" FontWeight="Bold" />
                                <TextBlock x:Name="SpecialText" Text="Special" Foreground="{DynamicResource NeonPurple}" FontSize="11" FontWeight="Bold" />
                            </WrapPanel>
                            <TextBlock Text="Mono: 948.37 MWe  ·  1842.56 kg/s" FontFamily="{DynamicResource AppMonoFontFamily}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        <!-- ================= Compact overlay + tooltip ================= -->
        <StackPanel x:Name="CompactGroup" Orientation="Horizontal" Spacing="28" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Border x:Name="CompactShell" Classes="overlay-shell compact-shell" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid x:Name="CompactRootGrid" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                    <TextBlock x:Name="CompactDragHandle" Grid.Column="0" Text="::" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel x:Name="CompactUnitGroup" Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0">
                        <Button Classes="cyber-preset active" Content="U1" Padding="5,2" />
                        <Button Classes="cyber-preset" Content="U2" Padding="5,2" />
                        <Button Classes="cyber-preset" Content="TCR" Padding="5,2" />
                    </StackPanel>
                    <TextBox x:Name="CompactDemandInput" Grid.Column="2" Classes="cyber" Text="950" Width="42" FontSize="11" Padding="2,0" Margin="0,0,6,0" />
                    <StackPanel x:Name="CompactPrimaryPanel" Grid.Column="3" VerticalAlignment="Center" Margin="2,0,6,0">
                        <TextBlock Text="98.4% APRM" Foreground="{DynamicResource NeonGreen}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="[1843 kg/s]" Foreground="{DynamicResource TextMuted}" FontSize="8" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="CompactSecondaryPanel" Grid.Column="4" VerticalAlignment="Center" Margin="2,0,6,0">
                        <TextBlock Text="948.37 MWe" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="Aux 26.44 MWe" Foreground="{DynamicResource TextMuted}" FontSize="8" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CompactCounterButton" Grid.Column="5" Classes="cyber" FontSize="10" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="02:41" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="10" />
                    </Button>
                    <StackPanel x:Name="CompactWindowControls" Grid.Column="6" Orientation="Horizontal" Spacing="3">
                        <Button Classes="cyber-header-btn" Content="□" FontSize="11" Padding="5,2" />
                        <Button Classes="cyber-close-btn" Content="X" FontSize="10" Padding="6,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Static copy of the hover tooltip so it is always visible -->
            <Border x:Name="TooltipSample" Background="{DynamicResource TooltipBg}" BorderBrush="{DynamicResource TooltipBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="10,7" MaxWidth="280" VerticalAlignment="Top">
                <StackPanel Spacing="4" MaxWidth="255">
                    <TextBlock Text="DEMAND PRESET" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="10" LetterSpacing="0.5" />
                    <Border Height="1" Background="{DynamicResource CyberBorder}" />
                    <TextBlock Text="Tooltip preview. Drag the slider or click a tick to jump to a common demand value."
                               Foreground="{DynamicResource TooltipBodyBrush}" FontSize="9.5" LineHeight="13.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= Operator Tablet HUD preview ================= -->
        <Border x:Name="TabletShell" Classes="overlay-shell popup-shell" Width="470" VerticalAlignment="Top" Padding="0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                <Border Grid.Row="0" Classes="hud-header"
                        CornerRadius="{Binding #TabletShell.CornerRadius, Converter={x:Static views:CornerRadiusEdgeConverter.TopOnly}}"
                        Padding="12,8" BorderBrush="{DynamicResource CyberBorder}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="OPERATOR TABLET" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="11" LetterSpacing="1" />
                            <Border Classes="status-pill" Padding="6,1">
                                <TextBlock Text="SYNCED · d638-4385" Foreground="{DynamicResource NeonGreen}" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Classes="cyber-header-btn" Content="HUD" Padding="6,2" FontSize="9" />
                            <Button Classes="cyber-close-btn" Content="X" Padding="6,2" FontSize="9" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="TabletNavBar" Grid.Row="1" Classes="hud-card nav-bar" Margin="10,8,10,0" ClipToBounds="True">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0" Classes="cyber-nav active" Content="UNIT 01"
                                CornerRadius="{Binding #TabletNavBar.CornerRadius, Converter={x:Static views:CornerRadiusEdgeConverter.LeftOnly}}"
                                HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Classes="cyber-nav" Content="UNIT 02" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2" Classes="cyber-nav" Content="MISC" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="3" Classes="cyber-nav" Content="CONFIG"
                                CornerRadius="{Binding #TabletNavBar.CornerRadius, Converter={x:Static views:CornerRadiusEdgeConverter.RightOnly}}"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="10,8,10,0">
                    <TextBox Grid.Column="0" Classes="cyber-search" Text="" PlaceholderText="Filter parameters..." />
                    <Border Grid.Column="1" Classes="status-pill" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DTL: 02:41" Foreground="{DynamicResource NeonGold}" FontSize="9.5" FontWeight="Bold" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="3" Spacing="5" Margin="10,8,10,10">
                    <TextBlock Classes="cyber-head" Text="UNIT 01 REACTOR PARAMETERS" />
                    <Border Classes="hud-card cyber-data-row" Padding="10,5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="APRM Power" Foreground="{DynamicResource TextLight}" FontSize="11" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="hud-card sub-panel" Width="140" Padding="8,3">
                                <TextBlock Text="98.40%" Foreground="{DynamicResource NeonGreen}" FontFamily="{DynamicResource AppMonoFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border Classes="hud-card cyber-data-row" Padding="10,5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Generator Output" Foreground="{DynamicResource TextLight}" FontSize="11" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="hud-card sub-panel" Width="140" Padding="8,3">
                                <TextBlock Text="948.37 MW" Foreground="{DynamicResource NeonCyan}" FontFamily="{DynamicResource AppMonoFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border Classes="hud-card cyber-data-row" Padding="10,5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Target Demand" Foreground="{DynamicResource TextLight}" FontSize="11" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="hud-card sub-panel" Width="140" Padding="8,3">
                                <TextBlock Text="950 MW" Foreground="{DynamicResource NeonGold}" FontFamily="{DynamicResource AppMonoFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border Classes="hud-card cyber-data-row" Padding="10,5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Reactor Temp / Fuel" Foreground="{DynamicResource TextLight}" FontSize="11" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="hud-card sub-panel" Width="140" Padding="8,3">
                                <TextBlock Text="284 C · 72%" Foreground="{DynamicResource NeonPurple}" FontFamily="{DynamicResource AppMonoFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- Temporary "this is where the colour is used" highlights (not part of the overlay). -->
    <Canvas x:Name="HighlightLayer" IsHitTestVisible="False" />
    </Panel>
</UserControl>
