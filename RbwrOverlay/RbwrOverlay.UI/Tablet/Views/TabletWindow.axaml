<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RbwrOverlay.UI.Tablet.ViewModels"
        xmlns:views="using:RbwrOverlay.UI.Tablet.Views"
        x:Class="RbwrOverlay.UI.Tablet.Views.TabletWindow"
        x:DataType="vm:TabletViewModel"
        x:CompileBindings="True"
        Title="RBWR Tablet"
        Icon="avares://RbwrOverlay/Assets/icon.ico"
        Width="620" Height="350"
        FontFamily="Segoe UI, Tahoma, Geneva, Verdana, sans-serif"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsTopmost}">

    <Grid x:Name="WindowRoot">
        <LayoutTransformControl x:Name="ScaleHost" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid x:Name="TabletRoot" Width="800" Height="452">
                <views:TabletHudView />
            </Grid>
        </LayoutTransformControl>
    </Grid>
</Window>
