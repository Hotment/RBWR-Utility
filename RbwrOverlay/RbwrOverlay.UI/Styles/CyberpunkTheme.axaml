<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="using:RbwrOverlay.UI.Behaviors">

    <Styles.Resources>
        <FontFamily x:Key="AppFontFamily">Consolas, 'Segoe UI', Inter, monospace</FontFamily>
        <FontFamily x:Key="AppMonoFontFamily">Consolas, monospace</FontFamily>

        <Color x:Key="CyberMainColor">#070a12</Color>
        <Color x:Key="CyberCardColor">#0f1422</Color>
        <Color x:Key="CyberHeaderColor">#05070d</Color>
        <Color x:Key="CyberBorderColor">#1b253b</Color>
        <Color x:Key="CyberBorderGlowColor">#00f0ff</Color>

        <Color x:Key="NeonCyanColor">#00f0ff</Color>
        <Color x:Key="NeonGreenColor">#39ff14</Color>
        <Color x:Key="NeonRedColor">#ff003c</Color>
        <Color x:Key="NeonGoldColor">#ffaa00</Color>
        <Color x:Key="NeonPurpleColor">#b026ff</Color>

        <Color x:Key="TextLightColor">#ffffff</Color>
        <Color x:Key="TextMutedColor">#73839c</Color>

        <SolidColorBrush x:Key="CyberMainBg" Color="#070a12" Opacity="0.94" />
        <SolidColorBrush x:Key="CyberCardBg" Color="#0f1422" Opacity="0.85" />
        <SolidColorBrush x:Key="CyberHeaderBg" Color="#05070d" Opacity="0.96" />
        <SolidColorBrush x:Key="DarkPanelBg" Color="#111726" Opacity="0.92" />
        <SolidColorBrush x:Key="CyberBorder" Color="#1b253b" />
        <SolidColorBrush x:Key="CyberBorderGlow" Color="#00f0ff" />

        <SolidColorBrush x:Key="NeonCyan" Color="#00f0ff" />
        <SolidColorBrush x:Key="NeonGreen" Color="#39ff14" />
        <SolidColorBrush x:Key="NeonRed" Color="#ff003c" />
        <SolidColorBrush x:Key="NeonGold" Color="#ffaa00" />
        <SolidColorBrush x:Key="NeonPurple" Color="#b026ff" />
        <SolidColorBrush x:Key="TextLight" Color="#ffffff" />
        <SolidColorBrush x:Key="TextMuted" Color="#73839c" />

        <SolidColorBrush x:Key="TooltipBg" Color="#f5080d18" />
        <SolidColorBrush x:Key="TooltipBorder" Color="#8800f0ff" />
        <SolidColorBrush x:Key="TooltipBodyBrush" Color="#dce6f5" />

        <SolidColorBrush x:Key="ControlHoverBg" Color="#192338" />
        <SolidColorBrush x:Key="ControlActiveBg" Color="#141f33" />
        <SolidColorBrush x:Key="ControlPressedBg" Color="#0e1726" />
        <SolidColorBrush x:Key="TextBoxFocusBg" Color="#131b2e" />

        <SolidColorBrush x:Key="SliderTrackFill" Color="#1b253b" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#243352" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#243352" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#00f0ff" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#33f3ff" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#00c4d4" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#00f0ff" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#5ff5ff" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#a0faff" />
    </Styles.Resources>

    <Style Selector="Window, UserControl">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
    </Style>

    <Style Selector="Border.overlay-shell">
        <Setter Property="Background" Value="{DynamicResource CyberMainBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorderGlow}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.overlay-shell.popup-shell">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.compact-shell">
        <Setter Property="Background" Value="{DynamicResource CyberMainBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="Border.hud-card">
        <Setter Property="Background" Value="{DynamicResource CyberCardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Border.hud-card.power-banner">
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Border.hud-card.sub-panel">
        <Setter Property="Background" Value="{DynamicResource DarkPanelBg}" />
    </Style>

    <Style Selector="Border.hud-header">
        <Setter Property="Background" Value="{DynamicResource CyberHeaderBg}" />
    </Style>

    <Style Selector="Border.hud-footer">
        <Setter Property="Background" Value="{DynamicResource DarkPanelBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Border.status-pill">
        <Setter Property="Background" Value="{DynamicResource DarkPanelBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Border.status-pill.sync-pill">
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Button.cyber-nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cyber-nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
    </Style>
    <Style Selector="Button.cyber-nav.active">
        <Setter Property="Background" Value="{DynamicResource ControlActiveBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
    </Style>

    <Style Selector="Button.cyber">
        <Setter Property="Background" Value="{DynamicResource CyberCardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cyber:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
    </Style>
    <Style Selector="Button.cyber:pressed">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBg}" />
    </Style>
    <Style Selector="Button.cyber.active">
        <Setter Property="Background" Value="{DynamicResource ControlActiveBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.cyber.error">
        <Setter Property="BorderBrush" Value="#66ffaa00" />
    </Style>
    <Style Selector="Button.cyber.error:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource NeonRed}" />
        <Setter Property="Background" Value="#251419" />
    </Style>

    <Style Selector="Button.cyber-blue">
        <Setter Property="Background" Value="{DynamicResource CyberCardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cyber-blue:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlActiveBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
    </Style>

    <Style Selector="Button.cyber-green">
        <Setter Property="Background" Value="{DynamicResource CyberCardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonGreen}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cyber-green:pointerover">
        <Setter Property="Background" Value="#10291d" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonGreen}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
    </Style>

    <Style Selector="Button.cyber-gold">
        <Setter Property="Background" Value="{DynamicResource CyberCardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonGold}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cyber-gold:pointerover">
        <Setter Property="Background" Value="#261b0a" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonGold}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
    </Style>

    <Style Selector="Button.cyber-red">
        <Setter Property="Background" Value="{DynamicResource CyberCardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonRed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cyber-red:pointerover">
        <Setter Property="Background" Value="#290e14" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonRed}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
    </Style>

    <Style Selector="Button.cyber-header-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cyber-header-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
    </Style>

    <Style Selector="Button.cyber-close, Button.cyber-close-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cyber-close:pointerover, Button.cyber-close-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource NeonRed}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
    </Style>

    <Style Selector="Button.cyber-preset">
        <Setter Property="Background" Value="{DynamicResource DarkPanelBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.cyber-preset:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
    </Style>
    <Style Selector="Button.cyber-preset.active">
        <Setter Property="Background" Value="{DynamicResource ControlActiveBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.cyber-tick">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cyber-tick:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
    </Style>
    <Style Selector="Button.cyber-tick.active">
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBox.cyber">
        <Setter Property="Background" Value="{DynamicResource CyberCardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
        <Setter Property="CaretBrush" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="behaviors:TextBoxBehaviors.AutoEndCaret" Value="True" />
    </Style>
    <Style Selector="TextBox.cyber:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
        <Setter Property="Background" Value="{DynamicResource TextBoxFocusBg}" />
    </Style>

    <Style Selector="ComboBox.cyber">
        <Setter Property="Background" Value="{DynamicResource DarkPanelBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ComboBox.cyber:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
    </Style>
    <Style Selector="ComboBox.cyber /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource CyberCardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ComboBox.cyber ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextLight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="ComboBox.cyber ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
    </Style>
    <Style Selector="ComboBox.cyber ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlActiveBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,-2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ScrollBar:vertical /template/ Grid#Root">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Rectangle#TrackRect">
        <Setter Property="Fill" Value="{DynamicResource DarkPanelBg}" />
        <Setter Property="Stroke" Value="{DynamicResource CyberBorder}" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource CyberBorder}" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource NeonCyan}" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
        <Setter Property="Background" Value="{DynamicResource NeonCyan}" />
    </Style>

    <Style Selector="ProgressBar.cyber-power">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource DarkPanelBg}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CyberBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TooltipBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="280" />
    </Style>
    <Style Selector="ToolTip TextBlock">
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

</Styles>