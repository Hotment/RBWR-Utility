<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RbwrOverlay.UI.ViewModels"
        xmlns:behaviors="using:RbwrOverlay.UI.Behaviors"
        x:Class="RbwrOverlay.UI.Views.ServerSyncWindow"
        x:DataType="vm:ServerSyncViewModel"
        Title="Live Server Sync &amp; DTL Calibration"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource CyberCardBg}"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        Width="380"
        Height="270"
        WindowStartupLocation="CenterOwner">

    <Border BorderBrush="{DynamicResource NeonCyan}"
            BorderThickness="1"
            CornerRadius="4">

        <Grid RowDefinitions="Auto,*">

            <Border Grid.Row="0"
                    Background="{DynamicResource CyberHeaderBg}"
                    Padding="10,6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="LIVE SERVER SYNC &amp; DTL CALIBRATION"
                               Foreground="{DynamicResource NeonCyan}"
                               FontWeight="Bold"
                               FontSize="11"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Classes="cyber-close"
                            Content="✕"
                            Command="{Binding CloseCommand}"
                            Padding="6,2" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="15,12"
                        Spacing="8">

                <TextBlock Text="Select or enter Job ID or Server ID (e.g. 77f6-4b2f):"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="10" />

                <Grid ColumnDefinitions="*,Auto">
                    <AutoCompleteBox Grid.Column="0"
                                     ItemsSource="{Binding AvailableJobIds}"
                                     Text="{Binding JobIdInput}"
                                     behaviors:AutoCompleteBehaviors.JobIdFilter="True"
                                     FontSize="12"
                                     FontFamily="Consolas, monospace"
                                     Margin="0,0,6,0" />

                    <Button Grid.Column="1"
                            Classes="cyber-green"
                            Content="Sync"
                            Command="{Binding SyncCommand}"
                            Padding="12,4" />
                </Grid>

                <Border Background="{DynamicResource CyberMainBg}"
                        BorderBrush="{DynamicResource CyberBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,4,0,0">

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding DemandTimeLeftText}"
                                   Foreground="{DynamicResource NeonGold}"
                                   FontWeight="Bold"
                                   FontSize="12" />

                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Calibrate:"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />

                            <Button Grid.Column="1"
                                    Classes="cyber"
                                    Content="-1s"
                                    Command="{Binding CalibrateMinusOneCommand}"
                                    Padding="6,2"
                                    Margin="0,0,3,0" />

                            <Button Grid.Column="2"
                                    Classes="cyber"
                                    Content="+1s"
                                    Command="{Binding CalibratePlusOneCommand}"
                                    Padding="6,2"
                                    Margin="0,0,6,0" />

                            <TextBox Grid.Column="3"
                                     Classes="cyber"
                                     Text="{Binding CustomCalibInput}"
                                     FontSize="11"
                                     Padding="4,2"
                                     Margin="0,0,3,0" />

                            <Button Grid.Column="4"
                                    Classes="cyber-green"
                                    Content="Set"
                                    Command="{Binding ApplyCustomCalibCommand}"
                                    Padding="8,2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding SyncStatusText}"
                           Foreground="{Binding SyncStatusBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           MinHeight="18" />

                <Button Classes="cyber"
                        Content="Close"
                        Command="{Binding CloseCommand}"
                        HorizontalAlignment="Right"
                        Padding="12,3" />

            </StackPanel>

        </Grid>
    </Border>
</Window>