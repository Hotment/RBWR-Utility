<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RbwrOverlay.UI.ViewModels"
        x:Class="RbwrOverlay.UI.Views.UpdateWindow"
        x:DataType="vm:UpdateViewModel"
        Title="System Update Available"
        Icon="/Assets/icon.ico"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Border Name="RootBorder"
            Background="{DynamicResource CyberMainBg}"
            BorderBrush="{DynamicResource NeonCyan}"
            BorderThickness="1"
            CornerRadius="8">

        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

            <Border Grid.Row="0"
                    Name="HeaderBorder"
                    Background="Transparent"
                    Padding="14,10,14,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Name="TitleText"
                                   Text="SYSTEM UPDATE AVAILABLE"
                                   Foreground="{DynamicResource NeonCyan}"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   LetterSpacing="0.8"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="cyber-close-btn"
                            Content="✕"
                            Command="{Binding RemindLaterCommand}"
                            Padding="6,2"
                            ToolTip.Tip="Remind Later" />
                </Grid>
            </Border>

            <Rectangle Grid.Row="1"
                       Fill="{DynamicResource CyberBorder}"
                       Height="1"
                       Margin="14,0" />

            <StackPanel Grid.Row="2"
                        Margin="14,12"
                        Spacing="10">

                <Border Background="{DynamicResource CyberCardBg}"
                        BorderBrush="{DynamicResource CyberBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="UPDATE DIAGNOSTICS"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           LetterSpacing="0.5" />
                                <Border Background="#141f33"
                                        BorderBrush="{DynamicResource NeonCyan}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="5,1">
                                    <TextBlock Text="{Binding LatestVersion, StringFormat='TARGET: v{0}'}"
                                               Foreground="{DynamicResource NeonCyan}"
                                               FontSize="8"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#10291d"
                                    BorderBrush="{DynamicResource NeonGreen}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6,2">
                                <TextBlock Text="READY TO INSTALL"
                                           Foreground="{DynamicResource NeonGreen}"
                                           FontWeight="Bold"
                                           FontSize="8" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,2">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AVAILABLE RELEASE"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="8"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LatestVersion, StringFormat='v{0}'}"
                                           Foreground="{DynamicResource NeonCyan}"
                                           FontWeight="Bold"
                                           FontSize="22"
                                           FontFamily="Consolas, 'Segoe UI', monospace" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                <Grid ColumnDefinitions="Auto,Auto">
                                    <TextBlock Text="CURRENT VERSION: " Foreground="{DynamicResource TextMuted}" FontSize="9" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentVersion, StringFormat='v{0}'}" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="9" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="3" IsVisible="{Binding IsDownloading}">
                            <ProgressBar Classes="cyber-power"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding DownloadProgress}"
                                         Foreground="{DynamicResource NeonCyan}" />
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="0%" Foreground="{DynamicResource TextMuted}" FontSize="8" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="{Binding DownloadStatus}" Foreground="{DynamicResource NeonCyan}" FontSize="8" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Text="100%" Foreground="{DynamicResource TextMuted}" FontSize="8" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#0b101c"
                        BorderBrush="{DynamicResource CyberBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10"
                        MaxHeight="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="RELEASE NOTES &amp; CHANGELOG"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       LetterSpacing="0.5"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding ReleaseNotes}"
                                       Foreground="{DynamicResource TextLight}"
                                       FontSize="11"
                                       LineHeight="16"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <Rectangle Grid.Row="3"
                       Fill="{DynamicResource CyberBorder}"
                       Height="1"
                       Margin="14,0" />

            <Border Grid.Row="4"
                    Name="FooterBorder"
                    Background="Transparent"
                    Padding="14,8,14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="SYSTEM UPDATE"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="9"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Classes="cyber"
                                Content="LATER"
                                Command="{Binding RemindLaterCommand}"
                                IsEnabled="{Binding !IsDownloading}"
                                Padding="12,5"
                                FontSize="10"
                                FontWeight="Bold" />

                        <Button Classes="cyber-red"
                                Content="SKIP VERSION"
                                Command="{Binding SkipVersionCommand}"
                                IsEnabled="{Binding !IsDownloading}"
                                Padding="12,5"
                                FontSize="10"
                                FontWeight="Bold" />

                        <Button Classes="cyber-green"
                                Content="UPDATE NOW"
                                Command="{Binding UpdateNowCommand}"
                                IsEnabled="{Binding !IsDownloading}"
                                Padding="16,5"
                                FontSize="10"
                                FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>