<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RbwrOverlay.UI.ViewModels"
        x:Class="RbwrOverlay.UI.Views.FeedbackWindow"
        x:DataType="vm:FeedbackViewModel"
        Title="Tickets &amp; Community Feedback"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource CyberCardBg}"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        Width="380"
        Height="270"
        WindowStartupLocation="CenterOwner">

    <Border BorderBrush="{DynamicResource NeonCyan}"
            BorderThickness="1"
            CornerRadius="4">

        <Grid RowDefinitions="Auto,*">

            <Border Grid.Row="0"
                    Background="{DynamicResource CyberHeaderBg}"
                    Padding="10,6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="TICKETS &amp; COMMUNITY FEEDBACK"
                               Foreground="{DynamicResource NeonCyan}"
                               FontWeight="Bold"
                               FontSize="11"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Classes="cyber-close"
                            Content="X"
                            Command="{Binding CancelCommand}"
                            Padding="6,2" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="16,14"
                        Spacing="12">

                <TextBlock Text="Bug reports, suggestions, and support discussions are now handled through our dedicated web tickets portal and Discord community."
                           Foreground="{DynamicResource TextLight}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           LineHeight="15" />

                <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                    <Button Grid.Column="0"
                            Classes="cyber-blue"
                            Content="Open Tickets Portal"
                            Command="{Binding OpenTicketsPageCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,4,0"
                            Padding="0,8"
                            FontSize="10"
                            FontWeight="SemiBold" />

                    <Button Grid.Column="1"
                            Classes="cyber"
                            Content="Join Discord Server"
                            Command="{Binding OpenDiscordServerCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="4,0,0,0"
                            Padding="0,8"
                            FontSize="10"
                            FontWeight="SemiBold" />
                </Grid>

                <Border Background="{DynamicResource DarkPanelBg}"
                        BorderBrush="{DynamicResource CyberBorder}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8,6">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Web: rbwr.hotment.dev/tickets"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="8"
                                   FontFamily="Consolas" />
                        <TextBlock Text="Discord: discord.gg/4eUQQcuv87"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="8"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Border>

                <Button Classes="cyber"
                        Content="Close"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Right"
                        Padding="14,4"
                        FontSize="10" />
            </StackPanel>
        </Grid>
    </Border>
</Window>