<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RbwrOverlay.UI.ViewModels"
             x:Class="RbwrOverlay.UI.Views.CompactOverlayView"
             x:DataType="vm:MainOverlayViewModel">

    <Border Background="{DynamicResource CyberMainBg}"
            BorderBrush="{DynamicResource NeonCyan}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="8,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BoxShadow="0 4 16 0 #33000000">

        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              VerticalAlignment="Center">

            <TextBlock Grid.Column="0"
                       Text="::"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="13"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Cursor="SizeAll"
                       Margin="0,0,6,0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2"
                        Margin="0,0,6,0">
                <Button Classes="cyber-preset"
                        Classes.active="{Binding IsUnit1Active}"
                        Content="U1"
                        Command="{Binding SelectUnitCommand}"
                        CommandParameter="1"
                        Padding="5,2" />
                <Button Classes="cyber-preset"
                        Classes.active="{Binding IsUnit2Active}"
                        Content="U2"
                        Command="{Binding SelectUnitCommand}"
                        CommandParameter="2"
                        Padding="5,2" />
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="cyber"
                    Content="-"
                    Command="{Binding AdjustDemandCommand}"
                    CommandParameter="-10"
                    FontSize="12"
                    FontWeight="Bold"
                    Padding="6,2"
                    Margin="0,0,2,0" />

            <TextBox Grid.Column="3"
                     Classes="cyber"
                     Text="{Binding DemandInput}"
                     Width="42"
                     FontSize="11"
                     Padding="2,0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Margin="0,0,2,0" />

            <Button Grid.Column="4"
                    Classes="cyber"
                    Content="+"
                    Command="{Binding AdjustDemandCommand}"
                    CommandParameter="10"
                    FontSize="12"
                    FontWeight="Bold"
                    Padding="6,2"
                    Margin="0,0,6,0" />

            <Button Grid.Column="5"
                    Classes="cyber-header-btn"
                    Content="OVR"
                    Foreground="{DynamicResource NeonPurple}"
                    IsVisible="{Binding IsRecircOverrideActive}"
                    Command="{Binding ResetRecircOverrideCommand}"
                    ToolTip.Tip="Recirc override active. Click to reset."
                    FontSize="9"
                    Padding="4,2"
                    Margin="0,0,6,0" />

            <StackPanel Grid.Column="6"
                        VerticalAlignment="Center"
                        Margin="2,0,6,0">
                <TextBlock Text="{Binding CompactRtpText}"
                           Foreground="{Binding MainPowerBrush}"
                           FontWeight="Bold"
                           FontSize="10"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CompactFlowText}"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="8"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="7"
                        VerticalAlignment="Center"
                        Margin="2,0,6,0">
                <TextBlock Text="{Binding GeneratorLoadText}"
                           Foreground="{DynamicResource NeonCyan}"
                           FontWeight="Bold"
                           FontSize="10"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding AuxUsageText, StringFormat='Aux {0}'}"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="8"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="8"
                    Classes="cyber"
                    Classes.error="{Binding HasSyncIssue}"
                    Command="{Binding ToggleCompactCounterCommand}"
                    ToolTip.Tip="{Binding CompactCounterTooltip}"
                    FontSize="10"
                    Padding="6,2"
                    HorizontalAlignment="Center"
                    Margin="0,0,6,0">
                <TextBlock Text="{Binding CompactDisplayCounterText}"
                           Foreground="{Binding CompactCounterBrush}"
                           FontWeight="Bold"
                           FontSize="10"
                           VerticalAlignment="Center" />
            </Button>

            <StackPanel Grid.Column="9"
                        Orientation="Horizontal"
                        Spacing="3">
                <Button Classes="cyber-header-btn"
                        Content="&#x25A1;"
                        Command="{Binding ToggleCompactCommand}"
                        ToolTip.Tip="Expand Full HUD"
                        FontSize="11"
                        Padding="5,2" />

                <Button Classes="cyber-close-btn"
                        Content="X"
                        Command="{Binding QuitCommand}"
                        ToolTip.Tip="Exit"
                        FontSize="10"
                        Padding="6,2" />
            </StackPanel>

        </Grid>
    </Border>
</UserControl>