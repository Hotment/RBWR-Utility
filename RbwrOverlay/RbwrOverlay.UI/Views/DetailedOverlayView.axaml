<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RbwrOverlay.UI.ViewModels"
             xmlns:models="using:RbwrOverlay.Core.Models"
             xmlns:behaviors="using:RbwrOverlay.UI.Behaviors"
             x:Class="RbwrOverlay.UI.Views.DetailedOverlayView"
             x:DataType="vm:MainOverlayViewModel">

    <Border x:Name="DetailedShell"
            Classes="overlay-shell"
            Width="470"
            Height="455">

        <Grid x:Name="DetailedRootGrid" RowDefinitions="Auto,Auto,*">

            <Grid x:Name="HeaderBar"
                  Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="0,0,0,10">

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="OverlayTitle"
                               Classes="overlay-title"
                               Text="RBWR OVERLAY"
                               Foreground="{DynamicResource NeonCyan}"
                               FontWeight="Bold"
                               FontSize="12"
                               LetterSpacing="1"
                               Cursor="SizeAll"
                               behaviors:TooltipBehaviors.Key="DragHandle"
                               VerticalAlignment="Center" />

                    <Border x:Name="SyncBadge"
                            Classes="status-pill sync-pill"
                            BorderBrush="{Binding ConnectionStatusBrush}"
                            Padding="6,2"
                            behaviors:TooltipBehaviors.Key="SyncBadge">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding ConnectionStatusText}"
                                       Foreground="{Binding ConnectionStatusBrush}"
                                       FontSize="9"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">

                    <Border Classes="status-pill"
                            BorderBrush="{DynamicResource NeonGold}"
                            Padding="5,1"
                            behaviors:TooltipBehaviors.Key="RecircBadge"
                            IsVisible="{Binding IsRecircOverrideActive}">
                        <TextBlock Text="{Binding RecircIndicatorText}"
                                   Foreground="{DynamicResource NeonGold}"
                                   FontSize="9"
                                   FontWeight="Bold" />
                    </Border>

                    <Button Classes="cyber-header-btn"
                            Content="{Binding PinSymbol}"
                            Command="{Binding ToggleTopmostCommand}"
                            behaviors:TooltipBehaviors.Key="PinButton" />

                    <Button Classes="cyber-header-btn"
                            Content="—"
                            Command="{Binding ToggleCompactCommand}"
                            behaviors:TooltipBehaviors.Key="CompactButton" />

                    <Button Classes="cyber-close-btn"
                            Content="X"
                            Command="{Binding QuitCommand}"
                            behaviors:TooltipBehaviors.Key="QuitButton" />
                </StackPanel>
            </Grid>

            <Border x:Name="NavBar"
                    Classes="hud-card nav-bar"
                    Grid.Row="1"
                    Margin="0,0,0,10">

                <Grid ColumnDefinitions="*,*,*,*">
                    <Button Grid.Column="0"
                            Classes="cyber-nav"
                            Classes.active="{Binding IsMonitorTabActive}"
                            Content="MONITOR"
                            Command="{Binding SwitchTabCommand}"
                            CommandParameter="Monitor"
                            behaviors:TooltipBehaviors.Key="TabMonitor"
                            HorizontalAlignment="Stretch" />

                    <Button Grid.Column="1"
                            Classes="cyber-nav"
                            Classes.active="{Binding IsSyncTabActive}"
                            Content="SERVER SYNC"
                            Command="{Binding SwitchTabCommand}"
                            CommandParameter="Sync"
                            behaviors:TooltipBehaviors.Key="TabSync"
                            HorizontalAlignment="Stretch" />

                    <Button Grid.Column="2"
                            Classes="cyber-nav"
                            Classes.active="{Binding IsSettingsTabActive}"
                            Content="CONFIG"
                            Command="{Binding SwitchTabCommand}"
                            CommandParameter="Settings"
                            behaviors:TooltipBehaviors.Key="TabSettings"
                            HorizontalAlignment="Stretch" />

                    <Button Grid.Column="3"
                            Classes="cyber-nav"
                            Classes.active="{Binding IsFeedbackTabActive}"
                            Content="FEEDBACK"
                            Command="{Binding SwitchTabCommand}"
                            CommandParameter="Feedback"
                            behaviors:TooltipBehaviors.Key="TabFeedback"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <Panel Grid.Row="2">

                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                      IsVisible="{Binding IsMonitorTabActive}">

                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,*,*"
                          Margin="0,0,0,8">
                        <Button Grid.Column="0"
                                Classes="cyber"
                                Classes.active="{Binding IsUnit1Active}"
                                Content="UNIT 01 (APRM)"
                                Command="{Binding SelectUnitCommand}"
                                CommandParameter="1"
                                behaviors:TooltipBehaviors.Key="Unit1"
                                Margin="0,0,3,0"
                                HorizontalAlignment="Stretch" />

                        <Button Grid.Column="1"
                                Classes="cyber"
                                Classes.active="{Binding IsUnit2Active}"
                                Content="UNIT 02 (RTP)"
                                Command="{Binding SelectUnitCommand}"
                                CommandParameter="2"
                                behaviors:TooltipBehaviors.Key="Unit2"
                                Margin="3,0,3,0"
                                HorizontalAlignment="Stretch" />

                        <Button Grid.Column="2"
                                Classes="cyber"
                                Classes.active="{Binding IsTcrActive}"
                                Content="TCR (MSS/OCL)"
                                Command="{Binding SelectUnitCommand}"
                                CommandParameter="3"
                                behaviors:TooltipBehaviors.Key="Tcr"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Stretch" />
                    </Grid>

                    <Border x:Name="PowerBanner"
                            Classes="hud-card power-banner"
                            Grid.Row="1"
                            BorderBrush="{Binding MainPowerBrush}"
                            Padding="12,8"
                            behaviors:TooltipBehaviors.Item="{Binding MainBannerTooltip}"
                            Margin="0,0,0,8">

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="MainPowerReadout"
                                       Classes="power-readout"
                                       Text="{Binding MainStatusPowerText}"
                                       Foreground="{Binding MainPowerBrush}"
                                       FontWeight="Bold"
                                       FontSize="24"
                                       HorizontalAlignment="Center" />

                            <ProgressBar x:Name="MainPowerBar"
                                         Classes="cyber-power"
                                         Value="{Binding ThermalPowerPercent}"
                                         Minimum="0"
                                         Maximum="120"
                                         Foreground="{Binding PowerBarBrush}"
                                         Margin="10,2" />

                            <TextBlock x:Name="MainPowerSubtext"
                                       Classes="power-subtext"
                                       Text="{Binding MainStatusSubText}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontWeight="Bold"
                                       FontSize="9"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="DemandPresetCard"
                            Classes="hud-card preset-card"
                            Grid.Row="2"
                            Padding="8,6"
                            behaviors:TooltipBehaviors.Key="DemandSlider"
                            Margin="0,0,0,8">
                        <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="DEMAND PRESET"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DemandSliderText}"
                                           Foreground="{DynamicResource NeonCyan}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Slider x:Name="DemandPresetSlider"
                                    Minimum="0"
                                    Maximum="1200"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="10"
                                    LargeChange="50"
                                    Value="{Binding DemandSliderValue, Mode=TwoWay}"
                                    behaviors:TooltipBehaviors.Key="DemandSlider"
                                    Margin="0,-2" />

                            <Grid ColumnDefinitions="300*,300*,350*,150*,100*"
                                  Margin="6,0,6,0">
                                <Button Grid.Column="0"
                                        Classes="cyber-tick"
                                        Classes.active="{Binding IsPreset0Active}"
                                        Content="0"
                                        Command="{Binding SetPresetDemandCommand}"
                                        CommandParameter="0"
                                        behaviors:TooltipBehaviors.Key="DemandPresetTick"
                                        HorizontalAlignment="Left" />
                                <Button Grid.Column="0"
                                        Classes="cyber-tick"
                                        Classes.active="{Binding IsPreset300Active}"
                                        Content="300"
                                        Command="{Binding SetPresetDemandCommand}"
                                        CommandParameter="300"
                                        behaviors:TooltipBehaviors.Key="DemandPresetTick"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,-12,0" />
                                <Button Grid.Column="1"
                                        Classes="cyber-tick"
                                        Classes.active="{Binding IsPreset600Active}"
                                        Content="600"
                                        Command="{Binding SetPresetDemandCommand}"
                                        CommandParameter="600"
                                        behaviors:TooltipBehaviors.Key="DemandPresetTick"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,-12,0" />
                                <Button Grid.Column="2"
                                        Classes="cyber-tick"
                                        Classes.active="{Binding IsPreset950Active}"
                                        Content="950"
                                        Command="{Binding SetPresetDemandCommand}"
                                        CommandParameter="950"
                                        behaviors:TooltipBehaviors.Key="DemandPresetTick"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,-12,0" />
                                <Button Grid.Column="3"
                                        Classes="cyber-tick"
                                        Classes.active="{Binding IsPreset1100Active}"
                                        Content="1100"
                                        Command="{Binding SetPresetDemandCommand}"
                                        CommandParameter="1100"
                                        behaviors:TooltipBehaviors.Key="DemandPresetTick"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,-14,0" />
                                <Button Grid.Column="4"
                                        Classes="cyber-tick"
                                        Classes.active="{Binding IsPreset1200Active}"
                                        Content="1200"
                                        Command="{Binding SetPresetDemandCommand}"
                                        CommandParameter="1200"
                                        behaviors:TooltipBehaviors.Key="DemandPresetTick"
                                        HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="MonitorMetricsGrid"
                          Grid.Row="3"
                          ColumnDefinitions="*,*"
                          RowDefinitions="*,*"
                          Margin="0,0,0,8">

                        <Border x:Name="DemandInputCard"
                                Classes="hud-card metric-card"
                                Grid.Row="0" Grid.Column="0"
                                Padding="8,6"
                                behaviors:TooltipBehaviors.Key="DemandInput"
                                Margin="0,0,4,4">
                            <StackPanel Spacing="3">
                                <TextBlock Text="DEMAND LOAD (MWe)" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                                    <Button Grid.Column="0" Classes="cyber" Content="-50" Command="{Binding AdjustDemandCommand}" CommandParameter="-50" behaviors:TooltipBehaviors.Key="DemandAdjustMinus50" FontSize="9" Padding="4,2" Margin="0,0,2,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="cyber" Content="-10" Command="{Binding AdjustDemandCommand}" CommandParameter="-10" behaviors:TooltipBehaviors.Key="DemandAdjustMinus10" FontSize="9" Padding="4,2" Margin="0,0,2,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Classes="cyber" Text="{Binding DemandInput}" behaviors:TooltipBehaviors.Key="DemandInput" FontSize="12" Padding="2,0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Classes="cyber" Content="+10" Command="{Binding AdjustDemandCommand}" CommandParameter="10" behaviors:TooltipBehaviors.Key="DemandAdjustPlus10" FontSize="9" Padding="4,2" Margin="2,0,0,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Classes="cyber" Content="+50" Command="{Binding AdjustDemandCommand}" CommandParameter="50" behaviors:TooltipBehaviors.Key="DemandAdjustPlus50" FontSize="9" Padding="4,2" Margin="2,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CorePowerCard"
                                Classes="hud-card metric-card"
                                Grid.Row="0" Grid.Column="1"
                                Padding="8,6"
                                behaviors:TooltipBehaviors.Key="RtpInput"
                                Margin="4,0,0,4">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding UnitSuffix, StringFormat='CORE POWER ({0}%)'}" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" VerticalAlignment="Center">
                                    <TextBox Classes="cyber" Text="{Binding RtpInput}" behaviors:TooltipBehaviors.Key="RtpInput" Width="74" FontSize="12" Padding="2,0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                    <TextBlock Text="%" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="GenLoadCard"
                                Classes="hud-card metric-card"
                                Grid.Row="1" Grid.Column="0"
                                Padding="8,6"
                                behaviors:TooltipBehaviors.Item="{Binding DetailedLoadTooltip}"
                                Margin="0,4,4,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DetailedLoadLabelText}" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="{Binding DetailedLoadValueText}" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="FlowCard"
                                Classes="hud-card metric-card"
                                Grid.Row="1" Grid.Column="1"
                                Padding="8,6"
                                behaviors:TooltipBehaviors.Item="{Binding DetailedFlowTooltip}"
                                Margin="4,4,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DetailedFlowLabelText}" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="{Binding FeedwaterFlowText}" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="StatusFooterBar"
                            Classes="hud-footer"
                            Grid.Row="4"
                            Padding="8,5">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0"
                                        Background="Transparent"
                                        behaviors:TooltipBehaviors.Key="UpcomingDemand"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        VerticalAlignment="Center">
                                <TextBlock Text="UPCOMING DEMAND:" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ServerDtlText}" Foreground="{Binding ServerDtlBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="cyber"
                                    Content="Open Tablet"
                                    Command="{Binding OpenTabletCommand}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="8,1"
                                    FontSize="9" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding DetailedBottomRightText}"
                                       behaviors:TooltipBehaviors.Item="{Binding DetailedBottomRightTooltip}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="9"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                </Grid>

                <ScrollViewer IsVisible="{Binding IsSyncTabActive}">
                    <StackPanel Spacing="10">

                        <Border Classes="hud-card sync-card"
                                Padding="10,8"
                                behaviors:TooltipBehaviors.Key="SyncNowButton">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="SERVER CONNECTION" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="10" />
                                    <TextBlock Text="{Binding HeartbeatAgeText}" Foreground="{DynamicResource TextMuted}" FontSize="9" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="cyber-green"
                                        Content="Sync Now"
                                        Command="{Binding ConnectServerFromInputCommand}"
                                        behaviors:TooltipBehaviors.Key="SyncNowButton"
                                        Padding="10,3" />
                            </Grid>
                        </Border>

                        <StackPanel Spacing="4" Background="Transparent" behaviors:TooltipBehaviors.Key="JobIdInput">
                            <TextBlock Text="Enter Roblox Job ID or Server Short ID (e.g. 77f6-4b2f):" Foreground="{DynamicResource TextMuted}" FontSize="9" />
                            <AutoCompleteBox ItemsSource="{Binding CachedJobIds}"
                                             Text="{Binding JobIdInput}"
                                             behaviors:AutoCompleteBehaviors.JobIdFilter="True"
                                             behaviors:TooltipBehaviors.Key="JobIdInput"
                                             FontSize="11"
                                             FontFamily="{DynamicResource AppMonoFontFamily}" />
                        </StackPanel>

                        <Border Classes="hud-card sync-card"
                                Padding="10,8"
                                behaviors:TooltipBehaviors.Key="DtlPanel">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="DEMAND TIME LEFT (DTL)" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding DtlCountdownText}" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="14" />
                                </Grid>

                                <ProgressBar Classes="cyber-power" Value="{Binding DtlProgressPercent}" Minimum="0" Maximum="100" Foreground="{DynamicResource NeonGold}" />

                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Calibrate:" Foreground="{DynamicResource TextMuted}" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" Classes="cyber" Content="-5s" Command="{Binding CalibrateDtlCommand}" CommandParameter="-5" behaviors:TooltipBehaviors.Key="CalibStepButton" Padding="5,2" Margin="0,0,2,0" FontSize="9" />
                                    <Button Grid.Column="2" Classes="cyber" Content="-1s" Command="{Binding CalibrateDtlCommand}" CommandParameter="-1" behaviors:TooltipBehaviors.Key="CalibStepButton" Padding="5,2" Margin="0,0,2,0" FontSize="9" />
                                    <Button Grid.Column="3" Classes="cyber" Content="+1s" Command="{Binding CalibrateDtlCommand}" CommandParameter="1" behaviors:TooltipBehaviors.Key="CalibStepButton" Padding="5,2" Margin="0,0,2,0" FontSize="9" />
                                    <TextBox Grid.Column="4" Classes="cyber" Text="{Binding CustomCalibInput}" PlaceholderText="Sec" behaviors:TooltipBehaviors.Key="CalibCustomInput" FontSize="9" Padding="2,0" Width="42" Margin="4,0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="5" Classes="cyber-green" Content="Set" Command="{Binding ApplyCustomCalibCommand}" behaviors:TooltipBehaviors.Key="CalibCustomInput" Padding="8,2" FontSize="9" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="hud-card sync-card"
                                Padding="10,8"
                                behaviors:TooltipBehaviors.Key="TurbineHealthPanel">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="TURBINE HEALTH DIAGNOSTICS" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{Binding TurbineHealthText}" Foreground="{Binding TurbineHealthBrush}" FontWeight="Bold" FontSize="10" />
                                </Grid>
                                <ProgressBar Classes="cyber-power" Value="{Binding TurbineHealthValue}" Minimum="0" Maximum="100" Foreground="{Binding TurbineHealthBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding SyncStatusMessage}"
                                   Foreground="{Binding SyncStatusBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsSettingsTabActive}">
                    <StackPanel Spacing="10" Margin="0,0,6,0">

                        <Border x:Name="ThemeConfigCard"
                                Classes="hud-card config-card"
                                Padding="10,6"
                                behaviors:TooltipBehaviors.Key="ThemeSelectorConfig">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="Theme:" VerticalAlignment="Center" FontSize="11" />
                                    <ComboBox Grid.Column="1"
                                              Classes="cyber"
                                              Width="195"
                                              ItemsSource="{Binding AvailableThemes}"
                                              SelectedItem="{Binding SelectedThemeItem, Mode=TwoWay}"
                                              behaviors:TooltipBehaviors.Key="ThemeDropdown">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:InstalledThemeInfo">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="2"
                                            Classes="cyber-blue"
                                            Content="Manage"
                                            Command="{Binding OpenThemeSelectorCommand}"
                                            behaviors:TooltipBehaviors.Key="ThemeManageButton"
                                            Margin="6,0,0,0"
                                            Padding="8,4"
                                            FontSize="10" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" Classes="cyber" Content="Install" Command="{Binding InstallThemeCommand}" behaviors:TooltipBehaviors.Key="ThemeInstallButton" Margin="0,0,2,0" FontSize="10" Padding="4,3" />
                                    <Button Grid.Column="1" Classes="cyber" Content="Reload" Command="{Binding ReloadThemesCommand}" behaviors:TooltipBehaviors.Key="ThemeReloadButton" Margin="2,0" FontSize="10" Padding="4,3" />
                                    <Button Grid.Column="2" Classes="cyber" Content="Template" Command="{Binding CreateTemplateThemeCommand}" behaviors:TooltipBehaviors.Key="ThemeTemplateButton" Margin="2,0" FontSize="10" Padding="4,3" />
                                    <Button Grid.Column="3" Classes="cyber" Content="Folder" Command="{Binding OpenThemesFolderCommand}" behaviors:TooltipBehaviors.Key="ThemeFolderButton" Margin="2,0,0,0" FontSize="10" Padding="4,3" />
                                </Grid>
                                <TextBlock Text="{Binding ThemeStatusMessage}"
                                           Foreground="{Binding ThemeStatusBrush}"
                                           IsVisible="{Binding HasThemeStatusMessage}"
                                           FontSize="9"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,4" behaviors:TooltipBehaviors.Key="HudOpacity">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="HUD Opacity:" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding OverlayOpacity, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="0.20" Maximum="1.00" Value="{Binding OverlayOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,-2" />
                            </StackPanel>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,4" behaviors:TooltipBehaviors.Key="FullHudScale">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="UI Scale (Full HUD):" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding UiScalePreview, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" />
                                </Grid>
                                <Slider x:Name="UiScaleSlider" Minimum="0.75" Maximum="2.00" Value="{Binding UiScalePreview}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,-2" />
                                <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,2,0,0">
                                    <Button Grid.Column="0" Classes="cyber-preset" Content="75%" Command="{Binding SetUiScalePresetCommand}" CommandParameter="0.75" Margin="0,0,2,0" />
                                    <Button Grid.Column="1" Classes="cyber-preset" Content="100%" Command="{Binding SetUiScalePresetCommand}" CommandParameter="1.0" Margin="1,0" />
                                    <Button Grid.Column="2" Classes="cyber-preset" Content="125%" Command="{Binding SetUiScalePresetCommand}" CommandParameter="1.25" Margin="1,0" />
                                    <Button Grid.Column="3" Classes="cyber-preset" Content="150%" Command="{Binding SetUiScalePresetCommand}" CommandParameter="1.5" Margin="1,0" />
                                    <Button Grid.Column="4" Classes="cyber-preset" Content="200%" Command="{Binding SetUiScalePresetCommand}" CommandParameter="2.0" Margin="2,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,4" behaviors:TooltipBehaviors.Key="CompactHudScale">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Compact Mode Scale:" VerticalAlignment="Center" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding CompactUiScalePreview, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" />
                                </Grid>
                                <Slider x:Name="CompactUiScaleSlider" Minimum="0.75" Maximum="2.00" Value="{Binding CompactUiScalePreview}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,-2" />
                                <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,2,0,0">
                                    <Button Grid.Column="0" Classes="cyber-preset" Content="75%" Command="{Binding SetCompactUiScalePresetCommand}" CommandParameter="0.75" Margin="0,0,2,0" />
                                    <Button Grid.Column="1" Classes="cyber-preset" Content="100%" Command="{Binding SetCompactUiScalePresetCommand}" CommandParameter="1.0" Margin="1,0" />
                                    <Button Grid.Column="2" Classes="cyber-preset" Content="125%" Command="{Binding SetCompactUiScalePresetCommand}" CommandParameter="1.25" Margin="1,0" />
                                    <Button Grid.Column="3" Classes="cyber-preset" Content="150%" Command="{Binding SetCompactUiScalePresetCommand}" CommandParameter="1.5" Margin="1,0" />
                                    <Button Grid.Column="4" Classes="cyber-preset" Content="200%" Command="{Binding SetCompactUiScalePresetCommand}" CommandParameter="2.0" Margin="2,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,6" behaviors:TooltipBehaviors.Key="HoverTooltipsToggle">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Hover Help Tooltips:" VerticalAlignment="Center" FontSize="11" />
                                <Button Grid.Column="1" Classes="cyber" Content="{Binding TooltipsStatusText}" Foreground="{Binding TooltipsStatusBrush}" Command="{Binding ToggleTooltipsCommand}" Padding="10,3" />
                            </Grid>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,6" behaviors:TooltipBehaviors.Key="DiscordPresenceToggle">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Discord Rich Presence:" VerticalAlignment="Center" FontSize="11" />
                                <Button Grid.Column="1" Classes="cyber" Content="{Binding DiscordPresenceStatusText}" Foreground="{Binding DiscordPresenceStatusBrush}" Command="{Binding ToggleDiscordPresenceCommand}" Padding="10,3" />
                            </Grid>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,6" behaviors:TooltipBehaviors.Key="RobloxTopmostToggle">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Topmost on Roblox (Auto-Detect):" VerticalAlignment="Center" FontSize="11" />
                                <Button Grid.Column="1" Classes="cyber" Content="{Binding TopmostStatusText}" Foreground="{Binding TopmostStatusBrush}" Command="{Binding ToggleRobloxTopmostCommand}" Padding="10,3" />
                            </Grid>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,6" behaviors:TooltipBehaviors.Key="AutoSyncOnJoinToggle">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Auto-Sync on Roblox Join:" VerticalAlignment="Center" FontSize="11" />
                                <Button Grid.Column="1" Classes="cyber" Content="{Binding AutoSyncOnJoinStatusText}" Foreground="{Binding AutoSyncOnJoinStatusBrush}" Command="{Binding ToggleAutoSyncOnJoinCommand}" Padding="10,3" />
                            </Grid>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,6" behaviors:TooltipBehaviors.Key="RecircOverrideConfig">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Recirc Override (%):" VerticalAlignment="Center" FontSize="11" />
                                <TextBox Grid.Column="1" Classes="cyber" Text="{Binding RecircOverrideInput}" Width="45" Padding="2,0" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Classes="cyber" Content="Reset" Command="{Binding ResetRecircOverrideCommand}" Padding="6,2" FontSize="11" />
                            </Grid>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,6" behaviors:TooltipBehaviors.Key="NextDemandTimerConfig">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Next Demand Switch Timer (s):" VerticalAlignment="Center" FontSize="11" />
                                <TextBox Grid.Column="1" Classes="cyber" Text="{Binding DemandThresholdSecondsInput}" Width="45" Padding="2,0" FontSize="11" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,6" behaviors:TooltipBehaviors.Key="TurbineAlarmConfig">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Turbine Health Alarm:" VerticalAlignment="Center" FontSize="11" />
                                    <Button Grid.Column="1" Classes="cyber" Content="{Binding TurbineAlertStatusText}" Foreground="{Binding TurbineAlertStatusBrush}" Command="{Binding ToggleTurbineAlertSettingCommand}" Padding="10,3" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Alarm Threshold (%):" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    <TextBox Grid.Column="1" Classes="cyber" Text="{Binding TurbineHealthThresholdInput}" Width="45" Padding="2,0" FontSize="10" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="hud-card config-card" Padding="10,6" behaviors:TooltipBehaviors.Key="OpenLogButton">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Diagnostics &amp; Log File:" VerticalAlignment="Center" FontSize="11" />
                                <Button Grid.Column="1" Classes="cyber" Content="Open Log" Command="{Binding OpenLogCommand}" behaviors:TooltipBehaviors.Key="OpenLogButton" Padding="8,3" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,2,0,4">
                            <TextBlock Text="{Binding GlobalAppVersion, StringFormat='RBWR Overlay v{0}'}" Foreground="{DynamicResource TextMuted}" FontSize="9" />
                            <TextBlock Text="•" Foreground="{DynamicResource TextMuted}" FontSize="9" />
                            <TextBlock Text="MIT License" Foreground="{DynamicResource TextMuted}" FontSize="9" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsFeedbackTabActive}">
                    <StackPanel Spacing="10" Margin="0,0,6,0">

                        <Border Classes="hud-card feedback-card" Padding="12,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="COMMUNITY TICKETS &amp; FEEDBACK" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" FontSize="11" />

                                <TextBlock Text="Bug reports, feature suggestions, and discussions have moved to the online web portal and Discord server for live responses and tracking."
                                           Foreground="{DynamicResource TextLight}"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           LineHeight="14" />

                                <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                    <Button Grid.Column="0"
                                            Classes="cyber-blue"
                                            Content="Open Tickets Portal"
                                            Command="{Binding OpenTicketsPageCommand}"
                                            behaviors:TooltipBehaviors.Key="OpenTicketsButton"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Margin="0,0,4,0"
                                            Padding="0,6"
                                            FontSize="10"
                                            FontWeight="SemiBold" />

                                    <Button Grid.Column="1"
                                            Classes="cyber"
                                            Content="Join Discord Server"
                                            Command="{Binding OpenDiscordServerCommand}"
                                            behaviors:TooltipBehaviors.Key="JoinDiscordButton"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Margin="4,0,0,0"
                                            Padding="0,6"
                                            FontSize="10"
                                            FontWeight="SemiBold" />
                                </Grid>

                                <Border Classes="hud-card sub-panel" Padding="8,6" Margin="0,2,0,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Web Portal: rbwr.hotment.dev/tickets"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="8"
                                                   FontFamily="{DynamicResource AppMonoFontFamily}" />
                                        <TextBlock Text="Discord Community: rbwr.hotment.dev/discord"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="8"
                                                   FontFamily="{DynamicResource AppMonoFontFamily}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="hud-card feedback-card" Padding="10,8" behaviors:TooltipBehaviors.Key="CheckUpdatesButton">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="SYSTEM UPDATES" Foreground="{DynamicResource NeonGold}" FontWeight="Bold" FontSize="10" />
                                    <Button Grid.Column="1" Classes="cyber" Content="Check Now" Command="{Binding CheckUpdatesCommand}" behaviors:TooltipBehaviors.Key="CheckUpdatesButton" Padding="8,2" FontSize="9" />
                                </Grid>

                                <TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource TextMuted}" FontSize="9" />

                                <StackPanel Spacing="4" IsVisible="{Binding IsUpdateAvailable}">
                                    <TextBlock Text="{Binding LatestVersionText}" Foreground="{DynamicResource NeonGreen}" FontWeight="Bold" FontSize="10" />
                                    <Button Classes="cyber-green" Content="Download &amp; Install" Command="{Binding UpdateNowCommand}" HorizontalAlignment="Left" Padding="8,3" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Panel>

        </Grid>
    </Border>
</UserControl>