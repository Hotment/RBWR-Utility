<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RbwrOverlay.UI.App"
             xmlns:local="using:RbwrOverlay.UI"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <DataTemplate DataType="local:TooltipItem">
            <StackPanel Spacing="4" MaxWidth="255">
                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource NeonCyan}"
                           FontWeight="Bold"
                           FontSize="10"
                           LetterSpacing="0.5"
                           TextAlignment="Left"
                           TextWrapping="Wrap" />
                <Border Height="1"
                        Background="{DynamicResource CyberBorder}" />
                <TextBlock Text="{Binding Description}"
                           Foreground="#dce6f5"
                           FontSize="9.5"
                           LineHeight="13.5"
                           TextAlignment="Left"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://RbwrOverlay/Styles/CyberpunkTheme.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon.ico"
                      ToolTipText="RBWR APRM Calculator"
                      Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show / Restore" Click="OnTrayRestoreClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Click="OnTrayExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>