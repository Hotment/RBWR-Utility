# Host interface to bind the Flask HTTP / WebSocket server (0.0.0.0 or 127.0.0.1)
HOST=0.0.0.0

# HTTP Port for the local Flask web service (default: 8400)
SERVER_PORT=8400

# Base URL used for public links, OAuth redirects, and client API communication
SERVER_BASE_URL=http://127.0.0.1:8400

# Secret key used for signing session cookies and CSRF tokens
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secure_flask_secret_key_here

# Disable background Roblox server polling worker (1 to disable, 0 to enable)
DISABLE_SC_WORKER=0

# Master fallback administrative credentials for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_master_admin_password

# Discord User ID granted root administrator privileges on the web dashboard
ROOT_DISCORD_ID=0000000000000000000

# Discord Developer Application credentials (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# Custom OAuth2 callback URI (optional; defaults to ${SERVER_BASE_URL}/discord/callback)
DISCORD_REDIRECT_URI=http://127.0.0.1:8400/discord/callback

# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Target Discord Server (Guild) ID
DISCORD_GUILD_ID=0000000000000000000

# Category ID under which new ticket channels / threads are created
DISCORD_TICKETS_CATEGORY_ID=0000000000000000000

# Forum or text channel ID for user suggestions and feature proposals
DISCORD_SUGGESTIONS_DISCUSSION_CHANNEL_ID=0000000000000000000

# Forum or text channel ID for user bug reports
DISCORD_BUGS_DISCUSSION_CHANNEL_ID=0000000000000000000

# Automatic role assignment for new guild members (optional)
DISCORD_AUTOROLE_ROLE_ID=
DISCORD_AUTOROLE_ROLE_NAME=

# Discord Channel ID for critical server exceptions and operational error logs
DISCORD_ERROR_ALERT_CHANNEL_ID=0000000000000000000

# Discord Channel ID for desktop overlay crash reports and stack traces
DISCORD_CRASH_ALERT_CHANNEL_ID=0000000000000000000

# Discord User ID mentioned when critical faults or crashes are dispatched
DISCORD_ERROR_ALERT_PING_USER_ID=0000000000000000000

# Custom URL for querying reactor snapshot metrics (defaults to ${SERVER_BASE_URL}/api/public-servers)
# RBWR_API_URL=http://127.0.0.1:8400/api/public-servers

# Cloudflare Turnstile CAPTCHA keys (https://dash.cloudflare.com/?to=/:account/turnstile)
# Leave empty to disable CAPTCHA checks in local development
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=